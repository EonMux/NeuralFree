/* topk_rows.comp - LLM_TopK_Rows: per-row top-k column selection by radix select.
 * GLSL twin of kernels/llm/sparse/topk_rows.cl (the semantic reference). Requires: common/nf_common.glsl,
 * common/topk_select.glsl.
 *
 * Arguments (buffers take bindings 0.. in order, scalars fill the push block in order):
 *   (i n_rows, i n_cols, i k, R float scores, W int idx_out)
 * Row r of idx_out (k slots at r*k) receives the columns of the kk = min(k, n_valid) largest scores
 * greater than -INF (NaN never selected), ties at the k-th value going to the lowest columns, ordered
 * as: columns above the k-th value in increasing order, then columns equal to it in increasing order;
 * slots kk .. k-1 receive -1. Equal floats are equal keys (+0 and -0 included).
 *
 * Method: nf_topk_select / nf_topk_compact (common/topk_select.glsl): a three-pass radix select of the k-th
 * largest key, then one ordered compaction in which each invocation owns a contiguous column range and writes its
 * selected columns straight to idx_out (NF_TOPK_EMIT).
 *
 * Dispatch: 1-D, one workgroup per row, linear group = row (nf_wg_id()); global = n_rows*L,
 * local = {L, 1, 1} with L a power of two <= LLM_DIMX (256 recommended).
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"

#define NF_TOPK_MAX 2048   /* the selection width of the sparse MLA kernels (validated on the host) */

layout(std430, binding = 0) readonly buffer NfTopkScores { float scores[]; };
layout(std430, binding = 1) writeonly buffer NfTopkOut { int idx_out[]; };
layout(push_constant) uniform NfTopkParams {
    int n_rows;
    int n_cols;
    int k;
} pc;

/* The compaction writes the selected columns straight to the row's output slots, from nf_topk_row_out (the row's
 * first slot, set before the compaction runs). */
uint nf_topk_row_out;
#define NF_TOPK_SRC scores
#define NF_TOPK_EMIT(slot, col) idx_out[nf_topk_row_out + (slot)] = (col)
#include "common/topk_select.glsl"

void main() {
    const uint row = nf_wg_id();
    /* The row depends only on the workgroup id, so this return is uniform per workgroup. */
    if (row >= uint(pc.n_rows)) {
        return;
    }
    const uint lid = gl_LocalInvocationID.x;
    const uint lsize = gl_WorkGroupSize.x;
    const uint n_cols = uint(max(pc.n_cols, 0));
    const uint k = uint(max(pc.k, 0));
    const uint sbase = row * n_cols;
    const uint obase = row * k;

    uint key_k;
    uint kk;
    uint n_eq;
    nf_topk_select(sbase, n_cols, min(k, uint(NF_TOPK_MAX)), false, key_k, kk, n_eq);
    nf_topk_row_out = obase;
    if (kk > 0u) {
        nf_topk_compact(sbase, n_cols, false, key_k, kk - n_eq, n_eq);
    }
    for (uint i = kk + lid; i < k; i += lsize) {
        idx_out[obase + i] = -1;
    }
}
