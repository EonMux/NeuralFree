shared uint nf_iq1s_grid[1024];
#define NF_IQ_SHARED_COPY() nf_iq_copy_loop(nf_iq1s_grid, NF_IQ1S_GRID, 1024u)
/* 16-bit packed grid entry i in [0, 2048). */
uint nf_iq1s(uint i) {
    return bitfieldExtract(nf_iq1s_grid[i >> 1], int((i & 1u) * 16u), 16);
}
/* Coordinate j in [0, 8) of grid entry i: -1, 0 or 1. */
int nf_iq1s_val(uint i, uint j) {
    return bitfieldExtract(int(nf_iq1s(i)), int(2u * j), 2);
}
