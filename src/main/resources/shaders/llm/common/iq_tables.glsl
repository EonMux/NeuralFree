/* common/iq_tables.glsl - IQ grid tables (generated from gguf/quant/QuantTables.java, identical to
 * the llama.cpp grids) and their workgroup-shared copies. Requires: common/nf_common.glsl,
 * common/quant_blocks.glsl.
 *
 * Grid tables from llama.cpp/ggml (ggml/src/ggml-common.h; the IQ1_S packing of
 * ggml-vulkan/vulkan-shaders/types.glsl), MIT License; see THIRD-PARTY-NOTICES.md.
 *
 * Only the grid used by the selected QTYPE is declared, so the shared footprint per variant is at
 * most 8 KB (IQ2_S). Shaders call nf_iq_init_shared() at the top of main(), from every invocation
 * and before any return; decoders then read the grids through the nf_iq* accessors only.
 *   IQ2_XXS / IQ2_XS / IQ2_S : uvec2 entries, 8 unsigned bytes, byte j = nf_iq_grid_byte(g, j)
 *   IQ3_XXS / IQ3_S          : uint entries, 4 unsigned bytes
 *   IQ1_S / IQ1_M            : 16-bit entries, coordinate j in {-1, 0, 1} = nf_iq1s_val(i, j)
 */
#ifndef NF_IQ_TABLES_GLSL
#define NF_IQ_TABLES_GLSL

#ifndef NF_QUANT_BLOCKS_GLSL
#error "common/iq_tables.glsl requires common/quant_blocks.glsl"
#endif

/* Byte j in [0, 8) of a packed 8-byte grid entry. */
uint nf_iq_grid_byte(uvec2 g, uint j) {
    return bitfieldExtract(j < 4u ? g.x : g.y, int((j & 3u) * 8u), 8);
}

/* ksigns_iq2xs[i] for i in [0, 128): the 7 sign bits plus an even-parity eighth bit
 * (equal to the 128-entry table of llama.cpp ggml-common.h). */
uint nf_iq2_ksigns(uint i) {
    return i | ((uint(bitCount(i)) & 1u) << 7);
}

