/* Copies const table src[n] into shared dst[n] with all invocations of the workgroup. */
#define nf_iq_copy_loop(dst, src, n) \
    for (uint nf_iq_i = gl_LocalInvocationIndex; nf_iq_i < (n); nf_iq_i += NF_WG_INVOCATIONS) { \
        dst[nf_iq_i] = src[nf_iq_i]; \
    }

/* Fills the shared grid of the selected QTYPE and synchronizes the workgroup; no-op for types
 * without a grid. Call from every invocation, in uniform control flow, before any return. */
void nf_iq_init_shared() {
#ifdef NF_IQ_SHARED_COPY
    NF_IQ_SHARED_COPY();
    barrier();
#endif
}

