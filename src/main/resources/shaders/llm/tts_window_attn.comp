/* tts_window_attn.comp - LLM_TtsWindowAttn: banded causal attention of a decoded window over the persisted
 * key/value prefix followed by the window's rows. GLSL twin of kernels/llm/speech.cl.
 * Requires: common/nf_common.glsl, common/tts_attend.glsl.
 *
 * Arguments: (i n_q, i n_head, i n_head_kv, i d_head, i prefix, i window, i base,
 *             R q, R keys, R values, W out).
 * Query i attends to key j when 0 <= prefix + i - j < window and j - prefix + base >= 0, the contiguous range
 * max(0, prefix - base, prefix + i - window + 1) .. prefix + i.
 * q[n_q][n_head*d_head], keys[prefix+n_q][n_head_kv*d_head], out[n_q][n_head*d_head].
 * Dispatch: 1-D, one workgroup per (query row, head) (nf_tts_attend), linear group i*n_head + h,
 * global = n_q*n_head*L, local = {L, 1, 1}.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"

layout(std430, binding = 0) readonly buffer NfWinQ { float q_in[]; };
layout(std430, binding = 1) readonly buffer NfWinK { float keys_in[]; };
layout(std430, binding = 2) readonly buffer NfWinV { float values_in[]; };
layout(std430, binding = 3) writeonly buffer NfWinO { float out_data[]; };

layout(push_constant) uniform NfWinParams {
    int n_q;
    int n_head;
    int n_head_kv;
    int d_head;
    int prefix;
    int window;
    int base;
} pc;

#include "common/tts_attend.glsl"

void main() {
    const uint g = nf_wg_id();
    /* uniform per workgroup */
    if (g >= uint(pc.n_q) * uint(pc.n_head)) {
        return;
    }
    const int i = int(g / uint(pc.n_head));
    const uint h = g - uint(i) * uint(pc.n_head);
    const uint kv_head = h / uint(pc.n_head / pc.n_head_kv);
    const uint q_off = uint(i) * uint(pc.n_head) * uint(pc.d_head) + h * uint(pc.d_head);
    const int j_lo = max(max(0, pc.prefix - pc.base), pc.prefix + i - pc.window + 1);
    nf_tts_attend(q_off, uint(pc.n_head_kv) * uint(pc.d_head), kv_head * uint(pc.d_head), pc.d_head, j_lo,
                  pc.prefix + i, q_off);
}
