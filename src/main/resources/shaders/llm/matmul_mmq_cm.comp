/* matmul_mmq_cm.comp - cooperative-matrix (tensor-core) GEMM over the llama.cpp MMQ quant types,
 * dequantizing the weight codes into fp16 tiles: the Vulkan tensor-core path for quantized weights,
 * as llama.cpp ggml/src/ggml-vulkan/vulkan-shaders/mul_mm_cm2.comp serves its quantized types through
 * fp16 cooperative matrices. GLSL sibling of NF_MMQ_GEMM / NF_MMQ_GEMM_KSPLIT
 * (kernels/llm/common/matmul_mmq_family.h). Requires: common/nf_common.glsl, common/quant_mmq.glsl.
 *
 * Variant rows select QTYPE=QT_<T> and, with NF_SPLIT_K=1, the split-K twin; kernel names are the
 * OpenCL names with a _CM suffix, e.g.
 *     Q4_K_MatMul_CM	matmul_mmq_cm.comp	QTYPE=QT_Q4_K
 *     Q4_K_MatMul_CM_KSplit	matmul_mmq_cm.comp	NF_SPLIT_K=1 QTYPE=QT_Q4_K
 *
 * Arguments (buffers take bindings 0.. in order, scalars fill the push block in order; the plain
 * form shares the argument list with {T}_MatMul_MMQ):
 *   plain:  (i M, i K, i N, i x_stride, i x_off, i y_stride, i y_off, R weight, R float x,
 *            W float y)
 *   ksplit: (i M, i K, i N, i x_stride, i x_off, i k_slice, R weight, R float x, W float partial)
 *   y[y_off + t*y_stride + r] = sum_{k < K} W[r][k] * x[x_off + t*x_stride + k],  r < M, t < N; the
 *   split-K twin writes partial[(slice * N + t) * M + r] for k in slice * k_slice .. +k_slice, slice
 *   taken from the work-group id, and LLM_SplitK_Reduce sums the planes into the output.
 * A weight row holds K / MMQ_BS blocks of MMQ_BB bytes; K is a multiple of MMQ_BS (32 or 256), so a
 * 16-deep stage never crosses a block or sub-block boundary and the per-stage (scale, offset) of
 * mmq_scale/mmq_off is the tile's exact row scale.
 *
 * Compute: 16x16x16 f16*f16 -> f32 cooperative matrices per subgroup (VK_KHR_cooperative_matrix).
 * A workgroup of 256 invocations computes 64 weight rows x 32 tokens in 16-deep stages, staging the
 * dequantized weight tile (scale * code + offset as fp16) and the fp32 activations converted to
 * fp16; the 8 output blocks of 16 rows x 16 tokens are distributed cyclically over the workgroup's
 * subgroups, so the kernel is correct for every full-subgroup size that divides 256. Products are
 * computed in fp16 and accumulated in fp32, so results differ from the dequantizing tiled GEMM by
 * the fp16 rounding of the staged tiles, as in llama.cpp mul_mm_cm2.comp. Rows past M and tokens
 * past N load 0; the stage stores to a shared staging tile and copies out bounds-checked.
 *
 * Dispatch: 2-D (never folded), global = {ceil(M / 64) * 256, ceil(N / 32), 1}, local = {256, 1, 1}.
 * Requires VK_KHR_cooperative_matrix, shaderFloat16, full subgroups and vulkanMemoryModel (glslang
 * declares the Vulkan memory model for every cooperative-matrix module; the dispatch picker checks
 * the device features before selecting this kernel; see DeviceFeature.COOPERATIVE_MATRIX).
 * Shared memory: a 64 x 24 half tile, a 32 x 40 half tile, 8 * 16 * 16 stage floats and the IQ grid
 * of the selected QTYPE (at most 8 KB).
 */
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require

#include "common/nf_common.glsl"

#ifndef QTYPE
#error "matmul_mmq_cm.comp requires QTYPE"
#endif

NF_BUFFER_VIEWS(0, w)
layout(std430, binding = 1) readonly buffer NfCmInput { float x_in[]; };
#ifdef NF_SPLIT_K
layout(std430, binding = 2) writeonly buffer NfCmPartial { float partial_out[]; };
layout(push_constant) uniform NfCmParams {
    int M; int K; int N; int x_stride; int x_off; int k_slice;
} pc;
#define NF_CM_OUT partial_out
#else
layout(std430, binding = 2) writeonly buffer NfCmOutput { float y_out[]; };
layout(push_constant) uniform NfCmParams {
    int M; int K; int N; int x_stride; int x_off; int y_stride; int y_off;
} pc;
#define NF_CM_OUT y_out
#endif

#include "common/quant_blocks.glsl"
#include "common/iq_tables.glsl"
#include "common/quant_legacy.glsl"
#include "common/quant_k.glsl"
#include "common/quant_mmq.glsl"

#define NF_CM_TM 64                          /* weight rows per workgroup tile */
#define NF_CM_TN 32                          /* tokens per workgroup tile */
#define NF_CM_TK 16                          /* reduction depth of one stage */
#define NF_CM_CM 16                          /* cooperative-matrix edge (M = K = N = 16) */
#define NF_CM_AS 24                          /* padded half stride of a weight-tile row */
#define NF_CM_BS 40                          /* padded half stride of an activation-tile row */
#define NF_CM_BLOCKS ((NF_CM_TM / NF_CM_CM) * (NF_CM_TN / NF_CM_CM)) /* 4 row blocks x 2 token blocks */

shared float16_t nf_cm_a[NF_CM_TM * NF_CM_AS];
shared float16_t nf_cm_b[NF_CM_TN * NF_CM_BS];
shared float nf_cm_stage[NF_CM_BLOCKS * NF_CM_CM * NF_CM_CM];

void main() {
    nf_iq_init_shared();

    const int M = pc.M;
    const int K = pc.K;
    const int N = pc.N;
#ifdef NF_SPLIT_K
    const int rtiles = (M + NF_CM_TM - 1) / NF_CM_TM;
    const int slice = int(gl_WorkGroupID.x) / rtiles;
    const int m0 = (int(gl_WorkGroupID.x) - slice * rtiles) * NF_CM_TM;
    const int kb = slice * pc.k_slice;
    const int ke = min(kb + pc.k_slice, K);
#else
    const int m0 = int(gl_WorkGroupID.x) * NF_CM_TM;
    const int kb = 0;
    const int ke = K;
#endif
    const int n0 = int(gl_WorkGroupID.y) * NF_CM_TN;
    const uint lid = gl_LocalInvocationID.x;
    const uint sgid = gl_SubgroupID;
    const uint nsg = gl_NumSubgroups;
    const uint row_bytes = uint(K / MMQ_BS) * uint(MMQ_BB);

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ca =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> cb =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>(float16_t(0.0));
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[NF_CM_BLOCKS];
    for (uint b = 0u; b < uint(NF_CM_BLOCKS); ++b) {
        acc[b] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    }

#ifdef NF_SPLIT_K
    for (int k0 = kb; k0 < ke; k0 += NF_CM_TK) {
#else
    for (int k0 = 0; k0 < K; k0 += NF_CM_TK) {
#endif
        /* dequantize the weight stage into fp16: invocation lid of a 16-row-lane x 16-depth-lane grid */
        {
            const uint tx = lid & 15u, ty = lid >> 4;
            const uint blk = uint(k0 / MMQ_BS) * uint(MMQ_BB);
            for (uint q = 0u; q < 4u; ++q) {
                const int r = m0 + int(tx) + 16 * int(q);
                const bool ok = r < M;
                const uint bp = (ok ? uint(r) * row_bytes : 0u) + blk;
                const float sc = ok ? mmq_scale(NF_WS_A, bp, k0) : 0.0;
                const float of = ok ? mmq_off(NF_WS_A, bp, k0) : 0.0;
                const uint e = uint(k0 + int(ty)) % uint(MMQ_BS);
                const float v = ok ? sc * float(mmq_code(NF_WS_A, bp, e)) + of : 0.0;
                nf_cm_a[(tx + 16u * q) * uint(NF_CM_AS) + ty] = float16_t(v);
            }
            for (uint j = 0u; j < 2u; ++j) {
                const int t = n0 + int(ty) + 16 * int(j);
                const int k = k0 + int(tx);
                const bool ok = t < N && k < K;
                nf_cm_b[(ty + 16u * j) * uint(NF_CM_BS) + tx] =
                    ok ? float16_t(x_in[uint(pc.x_off) + uint(t) * uint(pc.x_stride) + uint(k)])
                       : float16_t(0.0);
            }
        }
        barrier();
        for (uint i = 0u; i < uint(NF_CM_BLOCKS); ++i) {
            const uint b = sgid + i * nsg;
            if (b >= uint(NF_CM_BLOCKS)) {
                break;
            }
            const uint br = b >> 1, bc = b & 1u;
            coopMatLoad(ca, nf_cm_a, br * uint(NF_CM_CM) * uint(NF_CM_AS), uint(NF_CM_AS),
                        gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(cb, nf_cm_b, bc * uint(NF_CM_CM) * uint(NF_CM_BS), uint(NF_CM_BS),
                        gl_CooperativeMatrixLayoutColumnMajor);
            acc[i] = coopMatMulAdd(ca, cb, acc[i]);
        }
        barrier();
    }

    /* stage and copy out, bounds-checked per element */
    for (uint i = 0u; i < uint(NF_CM_BLOCKS); ++i) {
        const uint b = sgid + i * nsg;
        if (b >= uint(NF_CM_BLOCKS)) {
            break;
        }
        const int br = int(b >> 1), bc = int(b & 1u);
        coopMatStore(acc[i], nf_cm_stage, b * uint(NF_CM_CM * NF_CM_CM), uint(NF_CM_CM),
                     gl_CooperativeMatrixLayoutRowMajor);
        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared,
                       gl_SemanticsAcquireRelease);
        const uint lane = gl_SubgroupInvocationID;
        for (uint e = lane; e < uint(NF_CM_CM * NF_CM_CM); e += gl_SubgroupSize) {
            const int r = m0 + br * 16 + int(e >> 4);
            const int t = n0 + bc * 16 + int(e & 15u);
#ifdef NF_SPLIT_K
            if (r < M && t < N) {
                NF_CM_OUT[(uint(slice) * uint(N) + uint(t)) * uint(M) + uint(r)] =
                    nf_cm_stage[b * 256u + e];
            }
#else
            if (r < M && t < N) {
                NF_CM_OUT[uint(pc.y_off) + uint(t) * uint(pc.y_stride) + uint(r)] =
                    nf_cm_stage[b * 256u + e];
            }
#endif
        }
        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared,
                       gl_SemanticsAcquireRelease);
    }
}
