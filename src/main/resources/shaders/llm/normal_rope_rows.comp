/* normal_rope_rows.comp - LLM_NormalRopeRows: per-head NORMAL RoPE over a block of rows (the mimi decoder
 * transformer's q/k path). GLSL twin of kernels/llm/speech.cl. Requires: common/nf_common.glsl.
 *
 * Arguments: (i rows, i n_heads, i head_dim, i pos_base, i off, f theta_scale, R x, W y).
 *   row r rotates its adjacent pairs (2i, 2i+1) by angle = (pos_base + r) * theta_scale^i.
 * Dispatch: 1-D, one invocation per (row, head, pair), global = roundUp(rows*n_heads*half, L), local = {L, 1, 1}.
 * The block starts at element `off`; x and y must not overlap.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"

layout(std430, binding = 0) readonly buffer NfNrX { float x_in[]; };
layout(std430, binding = 1) writeonly buffer NfNrY { float y_out[]; };

layout(push_constant) uniform NfNrParams {
    int rows;
    int n_heads;
    int head_dim;
    int pos_base;
    int off;
    float theta_scale;
} pc;

void main() {
    const uint d_half = uint(pc.head_dim / 2);
    const uint idx = nf_global_id();
    if (idx >= uint(pc.rows) * uint(pc.n_heads) * d_half) {
        return;
    }
    const uint r = idx / (uint(pc.n_heads) * d_half);
    const uint rem = idx - r * uint(pc.n_heads) * d_half;
    const uint h = rem / d_half;
    const uint i = rem - h * d_half;
    const uint base = uint(pc.off) + (r * uint(pc.n_heads) + h) * uint(pc.head_dim);
    const float angle = float(pc.pos_base + int(r)) * pow(pc.theta_scale, float(i));
    const float cs = cos(angle);
    const float sn = sin(angle);
    const float x0 = x_in[base + 2u * i];
    const float x1 = x_in[base + 2u * i + 1u];
    y_out[base + 2u * i] = x0 * cs - x1 * sn;
    y_out[base + 2u * i + 1u] = x0 * sn + x1 * cs;
}
