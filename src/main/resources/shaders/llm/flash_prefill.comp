/* flash_prefill.comp - LLM_FlashAttn_<KV> and LLM_FlashAttn_Mixed tiled prefill attention (GLSL twin of
 * kernels/llm/flash_prefill.cl; layouts, grid, shared-memory plan, constraints and algorithm are documented there).
 * Requires: common/nf_common.glsl, common/act.glsl, common/kv_types.glsl, common/attn_common.glsl, common/reduce.glsl.
 *
 * Variants rows select the KV element type: KV=NF_KV_<type> (common/kv_types.glsl), or KV_MIXED=1 for
 * LLM_FlashAttn_Mixed, which reads K and V through the common/kv_types.glsl loaders with the types of its trailing
 * kv_types scalar (K type in bits 0-7, V type in bits 8-15; kernels/llm/common/attn_common.h); flag sg.
 * Arguments (buffers take bindings 0.. in order, scalars fill the push block in order):
 *   (i n_tokens, i n_head, i n_head_kv, i d_k, i d_v, i bq, i bk, i g_tile, i n_split, i split_len,
 *    i kv_start, i kv_end, i q_row_stride, i out_row_stride, i k_row_stride, i k_head_stride,
 *    i v_row_stride, i v_head_stride, f scale, f softcap, f max_bias, i causal, i swa_type, i n_swa,
 *    i bias_mode, i n_buckets, i max_distance, i has_sinks, i direct_out, i q_off, i out_off,
 *    R q, R k, R v, R<int> q_pos, R<int> kv_pos, R sinks, R rel_bias, W out, W partial[, i kv_types (KV_MIXED)])
 * Dispatch: 3-D, global {ceil(n_tokens / bq) * 128, n_head_kv * ceil(G / g_tile), n_split},
 * local {128, 1, 1}. The __sg variant needs full subgroups; 128 is a multiple of every subgroup size.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"
#include "common/act.glsl"
#include "common/kv_types.glsl"
#include "common/attn_common.glsl"

#if defined(KV) == defined(KV_MIXED)
#error "flash_prefill.comp requires exactly one of KV and KV_MIXED"
#endif

layout(std430, binding = 0) readonly buffer NfFaQ { float q_in[]; };
#if defined(KV_MIXED)
NF_BUFFER_VIEWS(1, kc)
NF_KV_LOADERS(kc)
NF_BUFFER_VIEWS(2, vc)
NF_KV_LOADERS(vc)
#else
NF_ATTN_KV_VIEWS(1, kc)
NF_ATTN_KV_VIEWS(2, vc)
#endif
layout(std430, binding = 3) readonly buffer NfFaQPos { int q_pos[]; };
layout(std430, binding = 4) readonly buffer NfFaKvPos { int kv_pos[]; };
layout(std430, binding = 5) readonly buffer NfFaSinks { float sinks[]; };
layout(std430, binding = 6) readonly buffer NfFaRelBias { float rel_bias[]; };
layout(std430, binding = 7) writeonly buffer NfFaOut { float dst[]; };
layout(std430, binding = 8) writeonly buffer NfFaPartial { float partial[]; };

layout(push_constant) uniform NfFaParams {
    int n_tokens; int n_head; int n_head_kv; int d_k; int d_v;
    int bq; int bk; int g_tile; int n_split; int split_len;
    int kv_start; int kv_end;
    int q_row_stride; int out_row_stride;
    int k_row_stride; int k_head_stride; int v_row_stride; int v_head_stride;
    float scale; float softcap; float max_bias;
    int causal; int swa_type; int n_swa;
    int bias_mode; int n_buckets; int max_distance;
    int has_sinks; int direct_out; int q_off; int out_off;
#if defined(KV_MIXED)
    int kv_types;
#endif
} pc;

#if defined(KV_MIXED)
/* K and V reads at the types packed in pc.kv_types (common/attn_common.glsl). */
bool nf_fa_types_ok() {
    return nf_attn_kv_type_ok(nf_attn_kv_type_k(pc.kv_types)) && nf_attn_kv_type_ok(nf_attn_kv_type_v(pc.kv_types));
}

vec4 kc_load4(uint e) { return kc_kv_load4(e, nf_attn_kv_type_k(pc.kv_types)); }
vec4 vc_load4(uint e) { return vc_kv_load4(e, nf_attn_kv_type_v(pc.kv_types)); }
#else
bool nf_fa_types_ok() {
    return true;
}
#endif

#include "common/reduce.glsl"

/* qc[R * 64] | kvc[bk * 64] | S[R * bk] | m[R] | l[R] | alpha[R] */
shared float nf_fa_smem[NF_FA_SMEM_FLOATS];
shared float nf_fa_slope[NF_FD_MAX_G];

bool nf_fa_plan_ok() {
    const int rows = pc.bq * pc.g_tile;
    return nf_fa_types_ok()
        && pc.n_head > 0 && pc.n_head_kv > 0 && pc.n_head % pc.n_head_kv == 0
        && pc.g_tile >= 1 && pc.g_tile <= NF_FD_MAX_G && pc.bq >= 1 && pc.bk >= 1
        && pc.d_k > 0 && pc.d_v > 0 && (pc.d_k & 3) == 0 && (pc.d_v & 3) == 0 && pc.n_split >= 1 && pc.split_len > 0
        && rows * NF_FA_CHUNK + pc.bk * NF_FA_CHUNK + rows * pc.bk + 3 * rows <= NF_FA_SMEM_FLOATS
        && rows * pc.d_v <= NF_FA_WG * NF_FA_ACC_MAX
        && (pc.direct_out == 0 || pc.n_split == 1)
        && gl_WorkGroupSize.x == uint(NF_FA_WG);
}

/* Position bias of head h (nf_attn_bias of kernels/llm/common/attn_common.h); slope = ALiBi slope of h. */
float nf_fa_bias(int h, int p_q, int p_k, float slope) {
    if (pc.bias_mode == NF_ATTN_BIAS_ALIBI) {
        return slope * (-float(abs(p_q - p_k)));
    }
    if (pc.bias_mode == NF_ATTN_BIAS_T5_CAUSAL || pc.bias_mode == NF_ATTN_BIAS_T5_BIDIR) {
        const int bucket = nf_t5_bucket(p_k, p_q, pc.n_buckets, pc.max_distance,
                                        pc.bias_mode == NF_ATTN_BIAS_T5_BIDIR ? 1 : 0);
        return rel_bias[bucket * pc.n_head + h];
    }
    return 0.0;
}

/* NaN over the outputs of a call that violates the plan (workgroup (0, 0, 0) only). */
void nf_fa_poison() {
    if (gl_WorkGroupID.x != 0u || gl_WorkGroupID.y != 0u || gl_WorkGroupID.z != 0u
        || pc.n_tokens <= 0 || pc.n_head <= 0 || pc.d_v <= 0 || pc.n_split <= 0) {
        return;
    }
    const uint lid = gl_LocalInvocationID.x;
    if (pc.direct_out != 0) {
        const uint n = uint(pc.n_head * pc.d_v);
        for (int t = 0; t < pc.n_tokens; t++) {
            for (uint i = lid; i < n; i += gl_WorkGroupSize.x) {
                dst[uint(pc.out_off + t * pc.out_row_stride) + i] = NF_NAN;
            }
        }
    } else {
        const uint n = uint(pc.n_tokens * pc.n_head * pc.n_split * (pc.d_v + 2));
        for (uint i = lid; i < n; i += gl_WorkGroupSize.x) {
            partial[i] = NF_NAN;
        }
    }
}

void main() {
    if (!nf_fa_plan_ok()) {
        nf_fa_poison();
        return;   /* uniform across the workgroup: no barrier has been reached */
    }

    const int lid = int(gl_LocalInvocationID.x);
    const int split = int(gl_WorkGroupID.z);
    const int g_tile = pc.g_tile;
    const int bq = pc.bq;
    const int bk = pc.bk;
    const int d_k = pc.d_k;
    const int d_v = pc.d_v;
    const int G = pc.n_head / pc.n_head_kv;
    const int n_gt = (G + g_tile - 1) / g_tile;
    const int kvh = int(gl_WorkGroupID.y) / n_gt;
    const int gt = int(gl_WorkGroupID.y) - kvh * n_gt;
    const int h0 = kvh * G + gt * g_tile;
    const int g_cnt = min(g_tile, G - gt * g_tile);
    const int t0 = int(gl_WorkGroupID.x) * bq;
    const int R = bq * g_tile;
    const int k_begin = pc.kv_start + split * pc.split_len;
    const int k_stop = split < pc.n_split ? min(k_begin + pc.split_len, pc.kv_end) : k_begin;

    const int qc = 0;
    const int kvc = qc + R * NF_FA_CHUNK;
    const int sc = kvc + bk * NF_FA_CHUNK;
    const int m_s = sc + R * bk;
    const int l_s = m_s + R;
    const int a_s = l_s + R;

    for (int r = lid; r < R; r += NF_FA_WG) {
        nf_fa_smem[m_s + r] = -NF_INF;
        nf_fa_smem[l_s + r] = 0.0;
        nf_fa_smem[a_s + r] = 0.0;
    }
    if (lid < g_tile) {
        nf_fa_slope[lid] = (pc.bias_mode == NF_ATTN_BIAS_ALIBI && lid < g_cnt)
                           ? nf_alibi_slope(h0 + lid, pc.n_head, pc.max_bias) : 1.0;
    }

    const int n_pairs = R * d_v;
    float o[NF_FA_ACC_MAX];
    int pr[NF_FA_ACC_MAX];
    int pd[NF_FA_ACC_MAX];
    [[unroll]] for (int i = 0; i < NF_FA_ACC_MAX; i++) {
        const int pi = lid + i * NF_FA_WG;
        const int r = pi < n_pairs ? pi / d_v : 0;
        o[i] = 0.0;
        pr[i] = r;
        pd[i] = pi - r * d_v;
    }
    barrier();

    const uint k_head = uint(kvh * pc.k_head_stride);
    const uint v_head = uint(kvh * pc.v_head_stride);
    for (int kt = k_begin; kt < k_stop; kt += bk) {
        const int nk = min(bk, k_stop - kt);

        /* 0. uniform skip of tiles invisible to every row */
        float any_vis = 0.0;
        for (int idx = lid; idx < bq * nk; idx += NF_FA_WG) {
            const int i = idx / nk;
            const int tq = t0 + i;
            if (tq < pc.n_tokens
                && nf_attn_visible(q_pos[tq], kv_pos[kt + idx - i * nk], pc.causal, pc.swa_type, pc.n_swa) != 0) {
                any_vis = 1.0;
            }
        }
        any_vis = nf_wg_max(any_vis);
        if (any_vis == 0.0) {
            continue;
        }

        /* 1. S = Q K^T over head-dim chunks */
        for (int idx = lid; idx < R * bk; idx += NF_FA_WG) {
            nf_fa_smem[sc + idx] = 0.0;
        }
        for (int c = 0; c < d_k; c += NF_FA_CHUNK) {
            barrier();
            for (int idx = lid; idx < R * (NF_FA_CHUNK / 4); idx += NF_FA_WG) {
                const int r = idx / (NF_FA_CHUNK / 4);
                const int c4 = idx - r * (NF_FA_CHUNK / 4);
                const int d = c + 4 * c4;
                const int i = r / g_tile;
                const int g = r - i * g_tile;
                const int tq = t0 + i;
                vec4 val = vec4(0.0);
                if (tq < pc.n_tokens && g < g_cnt && d < d_k) {
                    const uint qi = uint(pc.q_off + tq * pc.q_row_stride + (h0 + g) * d_k + d);
                    val = vec4(q_in[qi], q_in[qi + 1u], q_in[qi + 2u], q_in[qi + 3u]);
                }
                const int b = qc + r * NF_FA_CHUNK + 4 * c4;
                nf_fa_smem[b] = val.x;
                nf_fa_smem[b + 1] = val.y;
                nf_fa_smem[b + 2] = val.z;
                nf_fa_smem[b + 3] = val.w;
            }
            for (int idx = lid; idx < bk * (NF_FA_CHUNK / 4); idx += NF_FA_WG) {
                const int kk = idx / (NF_FA_CHUNK / 4);
                const int c4 = idx - kk * (NF_FA_CHUNK / 4);
                const int d = c + 4 * c4;
                vec4 val = vec4(0.0);
                if (kk < nk && d < d_k) {
                    val = kc_load4(uint(kt + kk) * uint(pc.k_row_stride) + k_head + uint(d));
                }
                const int b = kvc + kk * NF_FA_CHUNK + 4 * c4;
                nf_fa_smem[b] = val.x;
                nf_fa_smem[b + 1] = val.y;
                nf_fa_smem[b + 2] = val.z;
                nf_fa_smem[b + 3] = val.w;
            }
            barrier();
            for (int idx = lid; idx < R * bk; idx += NF_FA_WG) {
                const int r = idx / bk;
                const int kk = idx - r * bk;
                const int qrow = qc + r * NF_FA_CHUNK;
                const int krow = kvc + kk * NF_FA_CHUNK;
                float acc = 0.0;
                for (int dd = 0; dd < NF_FA_CHUNK; dd++) {
                    const int x = (dd + kk) & (NF_FA_CHUNK - 1);
                    acc += nf_fa_smem[qrow + x] * nf_fa_smem[krow + x];
                }
                nf_fa_smem[sc + idx] += acc;
            }
        }
        barrier();

        /* 2. scores, bias and mask */
        for (int idx = lid; idx < R * bk; idx += NF_FA_WG) {
            const int r = idx / bk;
            const int kk = idx - r * bk;
            const int i = r / g_tile;
            const int g = r - i * g_tile;
            const int tq = t0 + i;
            float s = -NF_INF;
            if (kk < nk && tq < pc.n_tokens && g < g_cnt) {
                const int p_q = q_pos[tq];
                const int p_k = kv_pos[kt + kk];
                if (nf_attn_visible(p_q, p_k, pc.causal, pc.swa_type, pc.n_swa) != 0) {
                    s = nf_attn_score(nf_fa_smem[sc + idx], pc.scale, pc.softcap)
                      + nf_fa_bias(h0 + g, p_q, p_k, nf_fa_slope[g]);
                }
            }
            nf_fa_smem[sc + idx] = s;
        }
        barrier();

        /* 3. online softmax update per row */
        for (int r = lid; r < R; r += NF_FA_WG) {
            const int srow = sc + r * bk;
            const int rot = r % bk;
            const float m_old = nf_fa_smem[m_s + r];
            float m_new = m_old;
            for (int j = 0; j < bk; j++) {
                int kk = j + rot;
                kk = kk >= bk ? kk - bk : kk;
                m_new = max(m_new, nf_fa_smem[srow + kk]);
            }
            float sum = 0.0;
            for (int j = 0; j < bk; j++) {
                int kk = j + rot;
                kk = kk >= bk ? kk - bk : kk;
                const float p = nf_attn_rescale(nf_fa_smem[srow + kk], m_new);
                nf_fa_smem[srow + kk] = p;
                sum += p;
            }
            const float alpha = nf_attn_rescale(m_old, m_new);
            nf_fa_smem[l_s + r] = nf_fa_smem[l_s + r] * alpha + sum;
            nf_fa_smem[m_s + r] = m_new;
            nf_fa_smem[a_s + r] = alpha;
        }
        barrier();

        /* 4. O = O * alpha + P V over value chunks */
        [[unroll]] for (int i = 0; i < NF_FA_ACC_MAX; i++) {
            if (lid + i * NF_FA_WG < n_pairs) {
                o[i] *= nf_fa_smem[a_s + pr[i]];
            }
        }
        for (int c = 0; c < d_v; c += NF_FA_CHUNK) {
            for (int idx = lid; idx < bk * (NF_FA_CHUNK / 4); idx += NF_FA_WG) {
                const int kk = idx / (NF_FA_CHUNK / 4);
                const int c4 = idx - kk * (NF_FA_CHUNK / 4);
                const int d = c + 4 * c4;
                vec4 val = vec4(0.0);
                if (kk < nk && d < d_v) {
                    val = vc_load4(uint(kt + kk) * uint(pc.v_row_stride) + v_head + uint(d));
                }
                const int b = kvc + kk * NF_FA_CHUNK + 4 * c4;
                nf_fa_smem[b] = val.x;
                nf_fa_smem[b + 1] = val.y;
                nf_fa_smem[b + 2] = val.z;
                nf_fa_smem[b + 3] = val.w;
            }
            barrier();
            [[unroll]] for (int i = 0; i < NF_FA_ACC_MAX; i++) {
                const int dd = pd[i] - c;
                if (lid + i * NF_FA_WG < n_pairs && dd >= 0 && dd < NF_FA_CHUNK) {
                    const int prow = sc + pr[i] * bk;
                    float acc = 0.0;
                    for (int kk = 0; kk < nk; kk++) {
                        const float p = nf_fa_smem[prow + kk];
                        if (p != 0.0) {
                            acc += p * nf_fa_smem[kvc + kk * NF_FA_CHUNK + dd];
                        }
                    }
                    o[i] += acc;
                }
            }
            barrier();
        }
    }

    /* 5. output */
    [[unroll]] for (int i = 0; i < NF_FA_ACC_MAX; i++) {
        const int r = pr[i];
        const int d = pd[i];
        const int ti = r / g_tile;
        const int g = r - ti * g_tile;
        const int tq = t0 + ti;
        if (lid + i * NF_FA_WG < n_pairs && tq < pc.n_tokens && g < g_cnt && split < pc.n_split) {
            const int h = h0 + g;
            const float m = nf_fa_smem[m_s + r];
            const float l = nf_fa_smem[l_s + r];
            if (pc.direct_out != 0) {
                const vec2 fl = pc.has_sinks != 0 ? nf_attn_sink(m, l, sinks[h]) : vec2(1.0, l);
                dst[uint(pc.out_off + tq * pc.out_row_stride + h * d_v + d)] = fl.y > 0.0 ? o[i] * fl.x / fl.y : 0.0;
            } else {
                const uint pb = uint(((tq * pc.n_head + h) * pc.n_split + split) * (d_v + 2));
                partial[pb + uint(d)] = o[i];
                if (d == 0) {
                    partial[pb + uint(d_v)] = m;
                    partial[pb + uint(d_v + 1)] = l;
                }
            }
        }
    }
}
