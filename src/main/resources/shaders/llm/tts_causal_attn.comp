/* tts_causal_attn.comp - LLM_TtsCausalAttn: causal attention of one code-predictor step over a key/value cache of
 * rows 0..pos. GLSL twin of kernels/llm/speech.cl. Requires: common/nf_common.glsl, common/tts_attend.glsl.
 *
 * Arguments: (i n_head, i n_head_kv, i d_head, i pos, R q, R keys, R values, W out).
 *   out[h] = softmax_j(q[h] . keys[j][kv(h)] / sqrt(d_head)) . values[j][kv(h)]
 * q[n_head*d_head], keys[(pos+1)][n_head_kv*d_head], values of that shape, out[n_head*d_head].
 * Dispatch: 1-D, one workgroup per head (nf_tts_attend), global = n_head*L, local = {L, 1, 1}.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"

layout(std430, binding = 0) readonly buffer NfAttnQ { float q_in[]; };
layout(std430, binding = 1) readonly buffer NfAttnK { float keys_in[]; };
layout(std430, binding = 2) readonly buffer NfAttnV { float values_in[]; };
layout(std430, binding = 3) writeonly buffer NfAttnO { float out_data[]; };

layout(push_constant) uniform NfAttnParams {
    int n_head;
    int n_head_kv;
    int d_head;
    int pos;
} pc;

#include "common/tts_attend.glsl"

void main() {
    const uint h = nf_wg_id();
    /* uniform per workgroup */
    if (h >= uint(pc.n_head)) {
        return;
    }
    const uint kv_head = h / uint(pc.n_head / pc.n_head_kv);
    const uint q_off = h * uint(pc.d_head);
    nf_tts_attend(q_off, uint(pc.n_head_kv) * uint(pc.d_head), kv_head * uint(pc.d_head), pc.d_head, 0, pc.pos,
                  q_off);
}
