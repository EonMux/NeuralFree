/* norm_ext.comp - LLM_RowNorm, LLM_GroupRms, LLM_GroupNorm, LLM_ResidualMix, LLM_ResidualMixNorm,
 * LLM_RowNormQ8, LLM_ResidualMixNormQ8 and LLM_MulRowScale (GLSL twin of kernels/llm/norm_ext.cl).
 * Requires: common/nf_common.glsl, common/reduce.glsl (reduction ops), common/rope_common.glsl
 * (nf_rope_f16_bits, for the Q8_1 block scales).
 *
 * A variants row selects OP:
 *   OP_ROW_NORM        (i n_rows, i row_len, i row_stride, i mode, f eps, i flags, i w_rows, i x_off, i y_off,
 *                       float x, R float w, R float b, float y)
 *       row r: x at x_off + r*row_stride, y at y_off + r*row_stride, row_len floats;
 *       mode 0 RMS x*rsqrt(sum(x^2)/n + eps), 1 LAYER (x - mean)*rsqrt(var + eps),
 *       2 L2_CLAMP x/max(sqrt(sum(x^2)), eps), 3 L2_GDN x*rsqrt(sum(x^2)/n + eps/n)*rsqrt(n);
 *       then *w and +b of weight row (r % w_rows) when flags bit 0 / bit 1 is set.
 *   OP_GROUP_RMS       (i n_tokens, i d_inner, i n_group, f eps, i x_stride, i x_off, float x, R float w, float y)
 *       y[t*d_inner + g*gs + i] = x[x_off + t*x_stride + g*gs + i] * rsqrt(sum_g(x^2)/gs + eps) * w[g*gs + i],
 *       gs = d_inner / n_group.
 *   OP_GROUP_NORM      (i n_ch, i len, i n_groups, f eps, R float x, R float w, R float b, float y)
 *       channel-major [n_ch][len]; group g covers channels [g*cpg, min(g*cpg + cpg, n_ch)), cpg = ceil(n_ch/n_groups);
 *       y[c*len + t] = (x - mean_g) * rsqrt(var_g + eps) * w[c] + b[c].
 *   OP_RESIDUAL_MIX    (i n, i mode, f s, i inp_off, i cur_off, i out_off, i ab_len,
 *                       R float inp, R float cur, R float alpha, R float beta, float out)
 *       mode 0 a + c, 1 a + s*c, 2 a*alpha[i % ab_len] + c*beta[i % ab_len], 3 c + s*a.
 *   OP_RESIDUAL_MIX_NORM (i n_rows, i row_len, i mode, f eps, i flags, i w_rows, i mix_mode, f mix_s,
 *                       i x_off, i add_off, i y_off, float x, R float addend, R float w, R float b, float y)
 *       the OP_RESIDUAL_MIX modes 0/1 of x's row with addend's row, written back to x, then the OP_ROW_NORM
 *       of the sum into y, in one workgroup per row; x and y must not overlap. A row of a multiple of 4 floats
 *       at 16-byte aligned offsets that fits NF_NX_VEC4_MAX vec4 per invocation stays in registers between the
 *       mix and the norm (vec4 loads and stores, no re-read of x): the one-workgroup row is latency-bound, so the
 *       independent vec4 loads replace serial scalar round trips. Other rows take the scalar strided loop.
 *   OP_ROW_NORM_Q8     (OP_ROW_NORM's arguments, then W uchar q8)
 *   OP_RESIDUAL_MIX_NORM_Q8 (OP_RESIDUAL_MIX_NORM's arguments, then W uchar q8)
 *       the same y (and x) plus row r's Q8_1 blocks at byte r * (row_len / 32) * 36 of q8, with the bits
 *       LLM_QuantizeQ8_1 (quantize_q8_1.comp) writes for the y values; row_len a multiple of 32. The Q8 forms
 *       always take the scalar strided loop.
 *   OP_MUL_ROW_SCALE   (i n_rows, i row_len, i scale_len, R float scale, float x)
 *       x[r*row_len + c] *= scale[scale_len == 1 ? 0 : c].
 * Buffers take bindings 0.. in argument order; scalars fill the push block in argument order. Operands that
 * may alias another binding carry no restrict; every element is read and written by one invocation.
 *
 * Dispatch: 1-D, local = {L, 1, 1}. Reductions use one workgroup per vector (global = n_rows * L,
 * n_tokens * n_group * L or n_groups * L; the group index comes from nf_wg_id(), surplus groups exit
 * uniformly). Element-wise ops use one invocation per element over nf_global_id(): global = roundUp(n, L).
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"

#define OP_ROW_NORM       1
#define OP_GROUP_RMS      2
#define OP_GROUP_NORM     3
#define OP_RESIDUAL_MIX   4
#define OP_MUL_ROW_SCALE  5
#define OP_RESIDUAL_MIX_NORM 6
#define OP_ROW_NORM_Q8    7
#define OP_RESIDUAL_MIX_NORM_Q8 8

#if !defined(OP)
#error "norm_ext.comp requires OP"
#endif

#define NF_NORM_EXT_RMS       0
#define NF_NORM_EXT_LAYER     1
#define NF_NORM_EXT_L2_CLAMP  2
#define NF_NORM_EXT_L2_GDN    3
#define NF_NORM_EXT_HAS_W     1
#define NF_NORM_EXT_HAS_B     2

#define NF_MIX_ADD                 0
#define NF_MIX_SCALED              1
#define NF_MIX_ALPHA_BETA          2
#define NF_MIX_NORMED_INPUT_SCALED 3

#if OP == OP_ROW_NORM || OP == OP_ROW_NORM_Q8
layout(std430, binding = 0) readonly buffer NfNxX { float x_in[]; };
layout(std430, binding = 1) readonly buffer NfNxW { float w_in[]; };
layout(std430, binding = 2) readonly buffer NfNxB { float b_in[]; };
layout(std430, binding = 3) buffer NfNxY { float y_out[]; };
layout(push_constant) uniform NfNxParams {
    int n_rows;
    int row_len;
    int row_stride;
    int mode;
    float eps;
    int flags;
    int w_rows;
    int x_off;
    int y_off;
} pc;
#if OP == OP_ROW_NORM_Q8
NF_BUFFER_VIEWS_RW(4, q8)
#endif
#define NF_NORM_EXT_REDUCE 1
#elif OP == OP_GROUP_RMS
layout(std430, binding = 0) readonly buffer NfNxX { float x_in[]; };
layout(std430, binding = 1) readonly buffer NfNxW { float w_in[]; };
layout(std430, binding = 2) buffer NfNxY { float y_out[]; };
layout(push_constant) uniform NfNxParams {
    int n_tokens;
    int d_inner;
    int n_group;
    float eps;
    int x_stride;
    int x_off;
} pc;
#define NF_NORM_EXT_REDUCE 1
#elif OP == OP_GROUP_NORM
layout(std430, binding = 0) readonly buffer NfNxX { float x_in[]; };
layout(std430, binding = 1) readonly buffer NfNxW { float w_in[]; };
layout(std430, binding = 2) readonly buffer NfNxB { float b_in[]; };
layout(std430, binding = 3) writeonly buffer NfNxY { float y_out[]; };
layout(push_constant) uniform NfNxParams {
    int n_ch;
    int len;
    int n_groups;
    float eps;
} pc;
#define NF_NORM_EXT_REDUCE 1
#elif OP == OP_RESIDUAL_MIX
layout(std430, binding = 0) readonly buffer NfNxInp { float inp[]; };
layout(std430, binding = 1) readonly buffer NfNxCur { float cur[]; };
layout(std430, binding = 2) readonly buffer NfNxAlpha { float alpha[]; };
layout(std430, binding = 3) readonly buffer NfNxBeta { float beta[]; };
layout(std430, binding = 4) buffer NfNxOut { float out_v[]; };
layout(push_constant) uniform NfNxParams {
    int n;
    int mode;
    float s;
    int inp_off;
    int cur_off;
    int out_off;
    int ab_len;
} pc;
#elif OP == OP_MUL_ROW_SCALE
layout(std430, binding = 0) readonly buffer NfNxScale { float scale_in[]; };
layout(std430, binding = 1) buffer NfNxX { float x_io[]; };
layout(push_constant) uniform NfNxParams {
    int n_rows;
    int row_len;
    int scale_len;
} pc;
#elif OP == OP_RESIDUAL_MIX_NORM || OP == OP_RESIDUAL_MIX_NORM_Q8
layout(std430, binding = 0) buffer NfNxX { float x_in[]; };
layout(std430, binding = 1) readonly buffer NfNxAdd { float add_in[]; };
layout(std430, binding = 2) readonly buffer NfNxW { float w_in[]; };
layout(std430, binding = 3) readonly buffer NfNxB { float b_in[]; };
layout(std430, binding = 4) writeonly buffer NfNxY { float y_out[]; };
#if OP == OP_RESIDUAL_MIX_NORM
layout(std430, binding = 0) buffer NfNxX4 { vec4 x4[]; };
layout(std430, binding = 1) readonly buffer NfNxAdd4 { vec4 add4[]; };
layout(std430, binding = 2) readonly buffer NfNxW4 { vec4 w4[]; };
layout(std430, binding = 3) readonly buffer NfNxB4 { vec4 b4[]; };
layout(std430, binding = 4) writeonly buffer NfNxY4 { vec4 y4[]; };
#define NF_NX_VEC4_MAX 4   /* vec4 per invocation of the register-resident row: 4096 floats at 256 invocations */
#endif
layout(push_constant) uniform NfNxParams {
    int n_rows;
    int row_len;
    int mode;
    float eps;
    int flags;
    int w_rows;
    int mix_mode;
    float mix_s;
    int x_off;
    int add_off;
    int y_off;
} pc;
#if OP == OP_RESIDUAL_MIX_NORM_Q8
NF_BUFFER_VIEWS_RW(5, q8)
#endif
#define NF_NORM_EXT_REDUCE 1
#else
#error "norm_ext.comp: OP is not a norm-extension op"
#endif

#if defined(NF_NORM_EXT_REDUCE)
#include "common/reduce.glsl"

/* Sum of x_in[base + i] over i in [0, n), strided over the workgroup. */
float nf_norm_ext_sum(uint base, uint n) {
    float s = 0.0;
    for (uint i = gl_LocalInvocationID.x; i < n; i += gl_WorkGroupSize.x) {
        s += x_in[base + i];
    }
    return s;
}

/* Sum of x_in[base + i]^2 over i in [0, n). */
float nf_norm_ext_sumsq(uint base, uint n) {
    float s = 0.0;
    for (uint i = gl_LocalInvocationID.x; i < n; i += gl_WorkGroupSize.x) {
        const float v = x_in[base + i];
        s += v * v;
    }
    return s;
}

/* Sum of (x_in[base + i] - mean)^2 over i in [0, n). */
float nf_norm_ext_sqdev(uint base, uint n, float mean) {
    float s = 0.0;
    for (uint i = gl_LocalInvocationID.x; i < n; i += gl_WorkGroupSize.x) {
        const float d = x_in[base + i] - mean;
        s += d * d;
    }
    return s;
}
#endif

#if OP == OP_ROW_NORM || OP == OP_ROW_NORM_Q8 || OP == OP_RESIDUAL_MIX_NORM || OP == OP_RESIDUAL_MIX_NORM_Q8
/* Element i of a normalized row: ((x - mean) * scale [* post]) [* w] [+ b], as LLM_RowNorm writes it. */
float nf_norm_ext_value(uint xb, uint wb, uint i, float mean, float scale, float post) {
    float v = (x_in[xb + i] - mean) * scale;
    if (pc.mode == NF_NORM_EXT_L2_GDN) {
        v *= post;
    }
    const bool has_w = (pc.flags & NF_NORM_EXT_HAS_W) != 0;
    const bool has_b = (pc.flags & NF_NORM_EXT_HAS_B) != 0;
    /* one rounding for the weight and bias step (norm_ext.cl) */
    if (has_w && has_b) {
        v = fma(v, w_in[wb + i], b_in[wb + i]);
    } else if (has_w) {
        v *= w_in[wb + i];
    } else if (has_b) {
        v += b_in[wb + i];
    }
    return v;
}
#endif

#if OP == OP_ROW_NORM_Q8 || OP == OP_RESIDUAL_MIX_NORM_Q8
#include "common/rope_common.glsl"

/*
 * Element i of the row's Q8_1 form (nf_norm_ext_q8 of kernels/llm/norm_ext.cl, quantize_q8_1.comp's
 * arithmetic): every invocation calls it once per final-pass step, live = false past the row; the 32
 * elements of a block are the invocations of one aligned 32-wide segment. q8b is the row's first byte.
 */
void nf_norm_ext_q8(uint q8b, uint i, bool live, float v) {
    const float amax = nf_seg_max(live ? abs(v) : 0.0, 32u);
    const float d = amax / 127.0;
    const float id = d != 0.0 ? 1.0 / d : 0.0;
    const int q = live ? clamp(int(nf_roundf(v * id)), -127, 127) : 0;
    const float sum = nf_seg_sum(float(q), 32u);
    if (live) {
        const uint blk = q8b + (i / 32u) * 36u;
        q8_u8[blk + 4u + (i % 32u)] = uint8_t(uint(q) & 0xFFu);
        if (i % 32u == 0u) {
            q8_u16[blk >> 1] = uint16_t(nf_rope_f16_bits(d));
            q8_u16[(blk >> 1) + 1u] = uint16_t(nf_rope_f16_bits(sum * d));
        }
    }
}

/* The final pass of a Q8 row norm: every invocation runs ceil(row_len / L) steps. */
void nf_norm_ext_store_q8(uint row, uint xb, uint yb, uint wb, uint row_len, float mean, float scale, float post) {
    const uint lsize = gl_WorkGroupSize.x;
    const uint steps = (row_len + lsize - 1u) / lsize;
    const uint q8b = row * (row_len / 32u) * 36u;
    for (uint t = 0u; t < steps; ++t) {
        const uint i = t * lsize + gl_LocalInvocationID.x;
        const bool live = i < row_len;
        float v = 0.0;
        if (live) {
            v = nf_norm_ext_value(xb, wb, i, mean, scale, post);
            y_out[yb + i] = v;
        }
        nf_norm_ext_q8(q8b, i, live, v);
    }
}
#endif

#if OP == OP_RESIDUAL_MIX_NORM || OP == OP_RESIDUAL_MIX_NORM_Q8
/* The normalization of a row from its sum, its sum of squares and (LAYER) its squared deviation from the mean:
 * (mean, scale, post) with y = (x - mean) * scale * post before the weight and bias. */
vec3 nf_rmn_norm(float sum, float ss, float dev, float n) {
    if (pc.mode == NF_NORM_EXT_LAYER) {
        return vec3(sum / n, inversesqrt(dev / n + pc.eps), 1.0);
    }
    if (pc.mode == NF_NORM_EXT_L2_CLAMP) {
        return vec3(0.0, 1.0 / max(sqrt(ss), pc.eps), 1.0);
    }
    if (pc.mode == NF_NORM_EXT_L2_GDN) {
        return vec3(0.0, inversesqrt(ss / n + pc.eps / n), inversesqrt(n));
    }
    return vec3(0.0, inversesqrt(ss / n + pc.eps), 1.0);
}
#endif

#if OP == OP_RESIDUAL_MIX_NORM
/* The register-resident row: element offsets xb, ab, yb and wb are multiples of 4, row_len / 4 vec4 fit
 * NF_NX_VEC4_MAX per invocation. The weight and bias step rounds as nf_norm_ext_value's does. */
void nf_rmn_row4(uint xb, uint ab, uint yb, uint wb, uint row_len) {
    const uint lid = gl_LocalInvocationID.x;
    const uint n4 = row_len >> 2u;
    const float n = float(row_len);
    vec4 v[NF_NX_VEC4_MAX];
    float sum = 0.0;
    float ss = 0.0;
    [[unroll]] for (uint k = 0u; k < uint(NF_NX_VEC4_MAX); k++) {
        const uint i = lid + k * gl_WorkGroupSize.x;
        v[k] = vec4(0.0);
        if (i < n4) {
            const vec4 c = add4[(ab >> 2u) + i];
            const vec4 a = x4[(xb >> 2u) + i];
            v[k] = pc.mix_mode == NF_MIX_SCALED ? a + pc.mix_s * c : a + c;
            x4[(xb >> 2u) + i] = v[k];
            sum += (v[k].x + v[k].y) + (v[k].z + v[k].w);
            ss += dot(v[k], v[k]);
        }
    }
    float dev = 0.0;
    float tsum = 0.0;
    float tss = 0.0;
    if (pc.mode == NF_NORM_EXT_LAYER) {
        tsum = nf_wg_sum(sum);
        const float mean = tsum / n;
        [[unroll]] for (uint k = 0u; k < uint(NF_NX_VEC4_MAX); k++) {
            if (lid + k * gl_WorkGroupSize.x < n4) {
                const vec4 d = v[k] - mean;
                dev += dot(d, d);
            }
        }
        dev = nf_wg_sum(dev);
    } else {
        tss = nf_wg_sum(ss);
    }
    const vec3 msp = nf_rmn_norm(tsum, tss, dev, n);
    const bool has_w = (pc.flags & NF_NORM_EXT_HAS_W) != 0;
    const bool has_b = (pc.flags & NF_NORM_EXT_HAS_B) != 0;
    [[unroll]] for (uint k = 0u; k < uint(NF_NX_VEC4_MAX); k++) {
        const uint i = lid + k * gl_WorkGroupSize.x;
        if (i < n4) {
            vec4 o = (v[k] - msp.x) * msp.y;
            if (pc.mode == NF_NORM_EXT_L2_GDN) {
                o *= msp.z;
            }
            if (has_w && has_b) {
                o = fma(o, w4[(wb >> 2u) + i], b4[(wb >> 2u) + i]);
            } else if (has_w) {
                o *= w4[(wb >> 2u) + i];
            } else if (has_b) {
                o += b4[(wb >> 2u) + i];
            }
            y4[(yb >> 2u) + i] = o;
        }
    }
}
#endif

void main() {
#if OP == OP_ROW_NORM || OP == OP_ROW_NORM_Q8
    const uint row = nf_wg_id();
    if (row >= uint(pc.n_rows)) {
        return;
    }
    const uint row_len = uint(pc.row_len);
    const uint xb = uint(pc.x_off) + row * uint(pc.row_stride);
    const uint yb = uint(pc.y_off) + row * uint(pc.row_stride);
    const float n = float(pc.row_len);

    float mean = 0.0;
    float scale;
    float post = 1.0;
    if (pc.mode == NF_NORM_EXT_LAYER) {
        mean = nf_wg_sum(nf_norm_ext_sum(xb, row_len)) / n;
        const float var = nf_wg_sum(nf_norm_ext_sqdev(xb, row_len, mean)) / n;
        scale = inversesqrt(var + pc.eps);
    } else {
        const float ss = nf_wg_sum(nf_norm_ext_sumsq(xb, row_len));
        if (pc.mode == NF_NORM_EXT_L2_CLAMP) {
            scale = 1.0 / max(sqrt(ss), pc.eps);
        } else if (pc.mode == NF_NORM_EXT_L2_GDN) {
            scale = inversesqrt(ss / n + pc.eps / n);
            post = inversesqrt(n);
        } else {
            scale = inversesqrt(ss / n + pc.eps);
        }
    }

    const uint wb = (pc.w_rows > 1 ? row % uint(pc.w_rows) : 0u) * row_len;
#if OP == OP_ROW_NORM_Q8 || OP == OP_RESIDUAL_MIX_NORM_Q8
    nf_norm_ext_store_q8(row, xb, yb, wb, row_len, mean, scale, post);
#else
    for (uint i = gl_LocalInvocationID.x; i < row_len; i += gl_WorkGroupSize.x) {
        y_out[yb + i] = nf_norm_ext_value(xb, wb, i, mean, scale, post);
    }
#endif

#elif OP == OP_GROUP_RMS
    const uint wg = nf_wg_id();
    const uint n_group = uint(pc.n_group);
    const uint t = wg / n_group;
    if (t >= uint(pc.n_tokens)) {
        return;
    }
    const uint g = wg - t * n_group;
    const uint gs = uint(pc.d_inner) / n_group;
    const uint xb = uint(pc.x_off) + t * uint(pc.x_stride) + g * gs;
    const uint yb = t * uint(pc.d_inner) + g * gs;
    const uint wb = g * gs;

    const float ss = nf_wg_sum(nf_norm_ext_sumsq(xb, gs));
    const float scale = inversesqrt(ss / float(gs) + pc.eps);
    for (uint i = gl_LocalInvocationID.x; i < gs; i += gl_WorkGroupSize.x) {
        y_out[yb + i] = x_in[xb + i] * scale * w_in[wb + i];
    }

#elif OP == OP_GROUP_NORM
    const uint g = nf_wg_id();
    if (g >= uint(pc.n_groups)) {
        return;
    }
    const uint n_ch = uint(pc.n_ch);
    const uint len = uint(pc.len);
    const uint cpg = (n_ch + uint(pc.n_groups) - 1u) / uint(pc.n_groups);
    const uint c0 = g * cpg;
    const uint c1 = min(c0 + cpg, n_ch);
    if (c1 <= c0) {
        return;
    }
    const uint base = c0 * len;
    const uint cnt = (c1 - c0) * len;
    const float mean = nf_wg_sum(nf_norm_ext_sum(base, cnt)) / float(cnt);
    const float var = nf_wg_sum(nf_norm_ext_sqdev(base, cnt, mean)) / float(cnt);
    const float scale = inversesqrt(var + pc.eps);
    for (uint c = c0; c < c1; ++c) {
        const uint cb = c * len;
        const float wc = w_in[c];
        const float bc = b_in[c];
        for (uint t = gl_LocalInvocationID.x; t < len; t += gl_WorkGroupSize.x) {
            y_out[cb + t] = (x_in[cb + t] - mean) * scale * wc + bc;
        }
    }

#elif OP == OP_RESIDUAL_MIX
    const uint i = nf_global_id();
    if (i >= uint(pc.n)) {
        return;
    }
    const float a = inp[uint(pc.inp_off) + i];
    const float c = cur[uint(pc.cur_off) + i];
    float r;
    if (pc.mode == NF_MIX_SCALED) {
        r = a + pc.s * c;
    } else if (pc.mode == NF_MIX_ALPHA_BETA) {
        const uint k = pc.ab_len > 1 ? i % uint(pc.ab_len) : 0u;
        r = a * alpha[k] + c * beta[k];
    } else if (pc.mode == NF_MIX_NORMED_INPUT_SCALED) {
        r = c + pc.s * a;
    } else {
        r = a + c;
    }
    out_v[uint(pc.out_off) + i] = r;

#elif OP == OP_MUL_ROW_SCALE
    const uint idx = nf_global_id();
    const uint row_len = uint(pc.row_len);
    if (pc.row_len <= 0 || idx >= uint(pc.n_rows) * row_len) {
        return;
    }
    const uint c = idx % row_len;
    x_io[idx] = x_io[idx] * scale_in[pc.scale_len == 1 ? 0u : c];

#elif OP == OP_RESIDUAL_MIX_NORM || OP == OP_RESIDUAL_MIX_NORM_Q8
    const uint row = nf_wg_id();
    if (row >= uint(pc.n_rows)) {
        return;
    }
    const uint row_len = uint(pc.row_len);
    const uint xb = uint(pc.x_off) + row * row_len;
    const uint ab = uint(pc.add_off) + row * row_len;
    const uint yb = uint(pc.y_off) + row * row_len;
    const uint wb = (pc.w_rows > 1 ? row % uint(pc.w_rows) : 0u) * row_len;
    const float n = float(pc.row_len);
#if OP == OP_RESIDUAL_MIX_NORM
    if ((row_len & 3u) == 0u && row_len <= 4u * uint(NF_NX_VEC4_MAX) * gl_WorkGroupSize.x
        && ((xb | ab | yb) & 3u) == 0u) {
        nf_rmn_row4(xb, ab, yb, wb, row_len);
        return;   /* uniform across the workgroup */
    }
#endif

    float sum = 0.0;
    float ss = 0.0;
    for (uint i = gl_LocalInvocationID.x; i < row_len; i += gl_WorkGroupSize.x) {
        const float c = add_in[ab + i];
        const float v = pc.mix_mode == NF_MIX_SCALED ? x_in[xb + i] + pc.mix_s * c : x_in[xb + i] + c;
        x_in[xb + i] = v;
        sum += v;
        ss += v * v;
    }

    float tsum = 0.0;
    float tss = 0.0;
    float dev = 0.0;
    if (pc.mode == NF_NORM_EXT_LAYER) {
        tsum = nf_wg_sum(sum);
        const float mean = tsum / n;
        for (uint i = gl_LocalInvocationID.x; i < row_len; i += gl_WorkGroupSize.x) {
            const float d = x_in[xb + i] - mean;
            dev += d * d;
        }
        dev = nf_wg_sum(dev);
    } else {
        tss = nf_wg_sum(ss);
    }
    const vec3 msp = nf_rmn_norm(tsum, tss, dev, n);

#if OP == OP_RESIDUAL_MIX_NORM_Q8
    nf_norm_ext_store_q8(row, xb, yb, wb, row_len, msp.x, msp.y, msp.z);
#else
    for (uint i = gl_LocalInvocationID.x; i < row_len; i += gl_WorkGroupSize.x) {
        y_out[yb + i] = nf_norm_ext_value(xb, wb, i, msp.x, msp.y, msp.z);
    }
#endif
#endif
}
