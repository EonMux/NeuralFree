/* matvec_quant.comp - one-workgroup-per-row matvec op templates over a QT_DECODE_* weight decoder.
 * GLSL twin of the IQ_MATVEC .. IQ_BATCHMATMUL2D family (kernels/llm/common/matvec_family.h) and of the
 * hand-written Q8_0 / MXFP4 / IQ4_XS matvec kernels, which share these semantics.
 * Requires: common/nf_common.glsl, common/quant_blocks.glsl, common/iq_tables.glsl,
 * common/reduce.glsl, common/act.glsl and the decoder file that serves QTYPE.
 *
 * A variants row selects QTYPE=QT_<T> and OP=<op>; its kernel name is the OpenCL name, e.g.
 *     Q4_K_MatVecFusedGateUp	matvec_quant.comp	QTYPE=QT_Q4_K OP=OP_GATEUP_SILU	sg
 *
 * Arguments (buffers take bindings 0.. in order, scalars fill the push block in order):
 *   OP_MATVEC      (i out_dim, i in_dim, R weight, R float input, W float output)
 *   OP_MATVECN     (i out_dim, i in_dim, i n_tokens, R weight, R float input, W float output)
 *                  output[t * out_dim + row] = dot(weight row, input row t) for t in
 *                  [0, n_tokens); the weight row is read once for the whole token group (n_tokens
 *                  in [1, NF_MVQN_MAX], NF_MVQN_MAX mirrors kernels/llm/common/config.h) and its
 *                  token loop is unrolled with the uniform t < n_tokens guard
 *   OP_MATVEC2     same arguments and result, two rows per workgroup: global = ceil(out_dim / 2) * L,
 *                  pair p covers rows 2p and 2p+1 (the tail pair of an odd out_dim repeats the last
 *                  row's weights and drops its store)
 *   OP_MATVEC_ADD  (i out_dim, i in_dim, R weight, R float input, float addend_output)
 *                  addend_output[row] += dot(weight row, input)
 *   OP_LOGITS      (i vocab_size, i embed_dim, R weight, R float hidden, W float logits)
 *   OP_GATEUP_SILU,
 *   OP_GATEUP_GELU (i out_dim, i in_dim, R gate_weight, R up_weight, R float input, W float output)
 *                  output[row] = act(dot(gate row, input)) * dot(up row, input),
 *                  act = SiLU (_SILU) or GELU, tanh approximation (_GELU)
 *   OP_GATEUP2     same arguments and result as OP_GATEUP_SILU, two rows per workgroup:
 *                  global = ceil(out_dim / 2) * L, pair p covers rows 2p and 2p+1 of both weights
 *                  (the tail pair of an odd out_dim repeats the last row and drops its store)
 *   OP_MATVEC3     (i q_rows, i in_dim, i k_rows, i v_rows, R q_weight, R k_weight, R v_weight,
 *                   R float input, W float q_output, W float k_output, W float v_output)
 *                  the three OP_MATVEC products of one activation row in one launch (the stacked Q/K/V
 *                  projection): global = (q_rows + k_rows + v_rows) * L, workgroup r computing row r of
 *                  the weight its index falls in (Q rows first, then K, then V) with OP_MATVEC's exact
 *                  arithmetic, so every output equals the single-weight launch's bit for bit
 *   OP_BATCH       (i out_dim, i in_dim, i seq_len, R weight, R float input, W float output)
 *                  output[s * out_dim + row] = dot(weight row, input row s), s in [0, seq_len)
 *   OP_BATCH_2D    same arguments and result, one token per workgroup row
 * A weight row holds in_dim / QT_BS blocks of QT_BB bytes; input row s starts at s * in_dim.
 *
 * Dispatch: every op except OP_BATCH_2D is 1-D with global = rows * L and local = {L, 1, 1}, one
 * workgroup per output row (folded group counts are recovered by nf_wg_id(); OP_MATVEC3 counts the rows of
 * all three weights); OP_MATVEC2 and OP_GATEUP2 use global = ceil(rows / 2) * L, one workgroup per row pair. OP_BATCH_2D uses
 * global = {out_dim * L, seq_len, 1} and local = {L, 1, 1}. Any L is reduced exactly; the engine
 * passes multiples of 32, for which the block/invocation mapping equals the OpenCL kernels'.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"

#if !defined(OP) || !defined(QTYPE)
#error "matvec_quant.comp requires OP and QTYPE"
#endif

#if OP == OP_GATEUP_SILU || OP == OP_GATEUP_GELU || OP == OP_GATEUP2
#define NF_MV_GATEUP 1
#define NF_WEIGHT_STREAMS 2
NF_BUFFER_VIEWS(0, w)
NF_BUFFER_VIEWS(1, u)
layout(std430, binding = 2) readonly buffer NfMvInput { float x_in[]; };
layout(std430, binding = 3) writeonly buffer NfMvOutput { float y_out[]; };
layout(push_constant) uniform NfMvParams { int out_dim; int in_dim; } pc;
#elif OP == OP_MATVEC3
#define NF_WEIGHT_STREAMS 3
NF_BUFFER_VIEWS(0, w)
NF_BUFFER_VIEWS(1, u)
NF_BUFFER_VIEWS(2, v)
layout(std430, binding = 3) readonly buffer NfMvInput { float x_in[]; };
layout(std430, binding = 4) writeonly buffer NfMvOutput { float y_out[]; };
layout(std430, binding = 5) writeonly buffer NfMvOutputK { float y_k[]; };
layout(std430, binding = 6) writeonly buffer NfMvOutputV { float y_v[]; };
layout(push_constant) uniform NfMvParams { int out_dim; int in_dim; int k_rows; int v_rows; } pc;
#elif OP == OP_MATVECN
NF_BUFFER_VIEWS(0, w)
layout(std430, binding = 1) readonly buffer NfMvInput { float x_in[]; };
layout(std430, binding = 2) writeonly buffer NfMvOutput { float y_out[]; };
layout(push_constant) uniform NfMvParams { int out_dim; int in_dim; int n_tokens; } pc;
#elif OP == OP_MATVEC || OP == OP_MATVEC2 || OP == OP_MATVEC_ADD || OP == OP_LOGITS
NF_BUFFER_VIEWS(0, w)
layout(std430, binding = 1) readonly buffer NfMvInput { float x_in[]; };
#if OP == OP_MATVEC_ADD
layout(std430, binding = 2) buffer NfMvOutput { float y_out[]; };
#else
layout(std430, binding = 2) writeonly buffer NfMvOutput { float y_out[]; };
#endif
layout(push_constant) uniform NfMvParams { int out_dim; int in_dim; } pc;
#elif OP == OP_BATCH || OP == OP_BATCH_2D
NF_BUFFER_VIEWS(0, w)
layout(std430, binding = 1) readonly buffer NfMvInput { float x_in[]; };
layout(std430, binding = 2) writeonly buffer NfMvOutput { float y_out[]; };
layout(push_constant) uniform NfMvParams { int out_dim; int in_dim; int seq_len; } pc;
#else
#error "matvec_quant.comp: OP is not a matvec op"
#endif

#include "common/quant_blocks.glsl"
#include "common/iq_tables.glsl"
#include "common/reduce.glsl"
#include "common/act.glsl"
#include "common/quant_legacy.glsl"
#include "common/quant_k.glsl"
#include "common/quant_iq.glsl"
#include "common/quant_new.glsl"
#include "common/quant_ext.glsl"

#if !defined(QT_DECODE_DOT) || !defined(QT_BS) || !defined(QT_BB) || !defined(QT_TPS)
#error "matvec_quant.comp: no QT_DECODE_DOT decoder serves QTYPE"
#endif

float qt_x(uint i) {
    return x_in[i];
}

vec4 qt_x4(uint i) {
    return vec4(x_in[i], x_in[i + 1u], x_in[i + 2u], x_in[i + 3u]);
}

#if OP == OP_MATVECN
#ifndef NF_MVQN_MAX
#define NF_MVQN_MAX 16u
#endif
/* OP_MATVECN staging: one slot set per token, sized for the largest workgroup any variants row of
 * this template is dispatched with. */
#ifndef NF_MV_LMAX
#define NF_MV_LMAX 256u
#endif
shared float nf_mv_ts[NF_MVQN_MAX * NF_MV_LMAX];
#endif

/* This invocation's share of dot(weight row at rbase in stream ws, activations at xoff): the
 * (block, ltid) pairs t = lid, lid + L, ... with block = t / QT_TPS and ltid = t % QT_TPS, so the
 * QT_TPS invocations of one block are adjacent and every pair is visited once for any L. */
float nf_mv_row_partial(uint ws, uint rbase, uint xoff, uint nblk) {
    const uint pairs = nblk * uint(QT_TPS);
    float ps = 0.0;
    for (uint t = gl_LocalInvocationID.x; t < pairs; t += gl_WorkGroupSize.x) {
        const uint b = t / uint(QT_TPS);
        ps += qt_dot(ws, rbase + b * uint(QT_BB), xoff, b, t % uint(QT_TPS));
    }
    return ps;
}

#if OP == OP_MATVECN
/* ps[t] = this invocation's share of dot(weight row at rbase in stream ws, activation row t) for
 * t < ntok (rows hold n elements), the nf_mv_row_partial (block, ltid) pair mapping walked per
 * token with the weight block read once. The L shares of token t add to the full dot product. */
void nf_mv_row_partial_n(uint ws, uint rbase, uint n, uint nblk, uint ntok,
                         inout float ps[NF_MVQN_MAX]) {
    const uint pairs = nblk * uint(QT_TPS);
    for (uint t = 0u; t < NF_MVQN_MAX; ++t) {
        ps[t] = 0.0;
    }
    for (uint p = gl_LocalInvocationID.x; p < pairs; p += gl_WorkGroupSize.x) {
        const uint b = p / uint(QT_TPS);
        const uint bp = rbase + b * uint(QT_BB);
        const uint ltid = p % uint(QT_TPS);
        for (uint t = 0u; t < NF_MVQN_MAX; ++t) {
            if (t < ntok) ps[t] += qt_dot(ws, bp, t * n, b, ltid);
        }
    }
}

/* The nf_wg_sum steps applied to every token in lockstep (GLSL twin of NF_MVQTN_TREE,
 * kernels/llm/common/matvec_n.h): under USE_SUBGROUPS each subgroup reduces in hardware and lane 0
 * of each subgroup stores its leader slot, the leader slots combining linearly as nf_wg_sum
 * combines nf_red; otherwise the slots take the nf_wg_sum span tree (bounds-checked, so any local
 * size is reduced exactly) in lockstep. Token t's result is the nf_wg_sum of token t's partials,
 * independent of ntok. */
void nf_mv_tree_n(inout float ps[NF_MVQN_MAX], uint ntok, uint row) {
    const uint lid = gl_LocalInvocationID.x;
    const uint lsize = gl_WorkGroupSize.x;
    const uint out_dim = uint(pc.out_dim);
#if defined(USE_SUBGROUPS)
    for (uint t = 0u; t < NF_MVQN_MAX; ++t) {
        if (t < ntok) ps[t] = subgroupAdd(ps[t]);
    }
    if (gl_SubgroupInvocationID == 0u) {
        for (uint t = 0u; t < NF_MVQN_MAX; ++t) {
            if (t < ntok) nf_mv_ts[t * lsize + gl_SubgroupID] = ps[t];
        }
    }
    barrier();
    for (uint t = 0u; t < NF_MVQN_MAX; ++t) {
        if (t < ntok) {
            float acc = 0.0;
            for (uint i = 0u; i < gl_NumSubgroups; ++i) {
                acc += nf_mv_ts[t * lsize + i];
            }
            if (lid == 0u) {
                y_out[t * out_dim + row] = acc;
            }
        }
    }
#else
    for (uint t = 0u; t < NF_MVQN_MAX; ++t) {
        if (t < ntok) nf_mv_ts[t * lsize + lid] = ps[t];
    }
    barrier();
    const uint span = lsize <= 1u ? 1u : (1u << (uint(findMSB(lsize - 1u)) + 1u));
    for (uint s = span >> 1; s > 0u; s >>= 1) {
        if (lid < s && lid + s < lsize) {
            for (uint t = 0u; t < NF_MVQN_MAX; ++t) {
                if (t < ntok) nf_mv_ts[t * lsize + lid] += nf_mv_ts[t * lsize + lid + s];
            }
        }
        barrier();
    }
    if (lid == 0u) {
        for (uint t = 0u; t < NF_MVQN_MAX; ++t) {
            if (t < ntok) y_out[t * out_dim + row] = nf_mv_ts[t * lsize];
        }
    }
#endif
}
#endif

#ifdef NF_MV_GATEUP
/* Gate (stream A) and up (stream B) shares of one row, with the same pair mapping. */
void nf_mv_gateup_partial(uint rbase, uint nblk, inout float gs, inout float us) {
    const uint pairs = nblk * uint(QT_TPS);
    for (uint t = gl_LocalInvocationID.x; t < pairs; t += gl_WorkGroupSize.x) {
        const uint b = t / uint(QT_TPS);
        const uint bp = rbase + b * uint(QT_BB);
#ifdef QT_DECODE_DUAL
        qt_dot_dual(bp, bp, 0u, b, t % uint(QT_TPS), gs, us);
#else
        gs += qt_dot(NF_WS_A, bp, 0u, b, t % uint(QT_TPS));
        us += qt_dot(NF_WS_B, bp, 0u, b, t % uint(QT_TPS));
#endif
    }
}
#endif

void main() {
    nf_iq_init_shared();

    const uint lid = gl_LocalInvocationID.x;
    const uint out_dim = uint(pc.out_dim);
    const uint in_dim = uint(pc.in_dim);
    const uint nblk = in_dim / uint(QT_BS);
    const uint row_bytes = nblk * uint(QT_BB);

#if OP == OP_BATCH_2D
    /* 2-D dispatch (never folded); with local y == 1 the return is uniform per workgroup. */
    const uint row = gl_WorkGroupID.x;
    const uint s = gl_GlobalInvocationID.y;
    if (row >= out_dim || s >= uint(pc.seq_len)) {
        return;
    }
    const float acc = nf_wg_sum(nf_mv_row_partial(NF_WS_A, row * row_bytes, s * in_dim, nblk));
    if (lid == 0u) {
        y_out[s * out_dim + row] = acc;
    }
#else
    /* The row depends only on the workgroup id, so this return is uniform per workgroup. */
    const uint row = nf_wg_id();
#if OP == OP_MATVEC3
    if (row >= out_dim + uint(pc.k_rows) + uint(pc.v_rows)) {
        return;
    }
#else
    if (row >= out_dim) {
        return;
    }
#endif
    const uint rbase = row * row_bytes;
#if OP == OP_BATCH
    const uint seq_len = uint(pc.seq_len);
    for (uint s = 0u; s < seq_len; ++s) {
        const float acc = nf_wg_sum(nf_mv_row_partial(NF_WS_A, rbase, s * in_dim, nblk));
        if (lid == 0u) {
            y_out[s * out_dim + row] = acc;
        }
    }
#elif OP == OP_MATVECN
    /* One weight row against n_tokens float rows: the block loop streams the weight row once and
     * dots each block against every live token row; the whole token group is reduced in one pass
     * over nf_mv_ts, so token t's result is the exact single-row result. */
    const uint ntok = min(uint(pc.n_tokens), NF_MVQN_MAX);
    float ps[NF_MVQN_MAX];
    nf_mv_row_partial_n(NF_WS_A, rbase, in_dim, nblk, ntok, ps);
    nf_mv_tree_n(ps, ntok, row);
#elif OP == OP_MATVEC2
    /* Two rows per workgroup (pair p covers rows 2p and 2p+1): the activations are read once per
     * two weight rows. The tail pair of an odd row count repeats the last row's weights and drops
     * its second store, so control flow stays uniform. With one weight stream both rows read the
     * same binding, so the dual-block decode serves the row pair. */
    const uint pair = nf_wg_id();
    const uint row0 = pair * 2u;
    if (row0 >= out_dim) {
        return;
    }
    const uint row1 = min(row0 + 1u, out_dim - 1u);
    const uint rbase0 = row0 * row_bytes;
    const uint rbase1 = row1 * row_bytes;
    float ps0 = 0.0;
    float ps1 = 0.0;
    const uint pairs = nblk * uint(QT_TPS);
    for (uint t = lid; t < pairs; t += gl_WorkGroupSize.x) {
        const uint b = t / uint(QT_TPS);
        const uint ltid = t % uint(QT_TPS);
        const uint bp0 = rbase0 + b * uint(QT_BB);
        const uint bp1 = rbase1 + b * uint(QT_BB);
#ifdef QT_DECODE_DUAL
        qt_dot_dual(bp0, bp1, 0u, b, ltid, ps0, ps1);
#else
        ps0 += qt_dot(NF_WS_A, bp0, 0u, b, ltid);
        ps1 += qt_dot(NF_WS_A, bp1, 0u, b, ltid);
#endif
    }
    const vec2 o = nf_wg_sum2(ps0, ps1);
    if (lid == 0u) {
        y_out[row0] = o.x;
        if (row0 + 1u < out_dim) {
            y_out[row1] = o.y;
        }
    }
#elif OP == OP_GATEUP2
    /* Two rows per workgroup over both weights (pair p covers rows 2p and 2p+1): the activations are
     * read once per two row pairs, the second dual decode's input loads hitting L1. The tail pair of
     * an odd row count repeats the last row's weights and drops its second store, so control flow
     * stays uniform. */
    const uint pair = nf_wg_id();
    const uint row0 = pair * 2u;
    if (row0 >= out_dim) {
        return;
    }
    const uint row1 = min(row0 + 1u, out_dim - 1u);
    const uint rbase0 = row0 * row_bytes;
    const uint rbase1 = row1 * row_bytes;
    float gs0 = 0.0;
    float us0 = 0.0;
    float gs1 = 0.0;
    float us1 = 0.0;
    const uint pairs = nblk * uint(QT_TPS);
    for (uint t = lid; t < pairs; t += gl_WorkGroupSize.x) {
        const uint b = t / uint(QT_TPS);
        const uint ltid = t % uint(QT_TPS);
        const uint b0 = rbase0 + b * uint(QT_BB);
        const uint b1 = rbase1 + b * uint(QT_BB);
        qt_dot_dual(b0, b0, 0u, b, ltid, gs0, us0);
        qt_dot_dual(b1, b1, 0u, b, ltid, gs1, us1);
    }
    const vec4 v = nf_wg_sum4(gs0, us0, gs1, us1);
    if (lid == 0u) {
        y_out[row0] = nf_silu(v.x) * v.y;
        if (row0 + 1u < out_dim) {
            y_out[row1] = nf_silu(v.z) * v.w;
        }
    }
#elif OP == OP_MATVEC3
    /* Workgroup `row` (checked against out_dim, the Q rows, above) belongs to K or V past the Q rows; each
     * branch calls the single-row partial with a constant stream, so the reads fold to that weight's views
     * and the row takes OP_MATVEC's partial and reduction unchanged. */
    const uint k_rows = uint(pc.k_rows);
    float ps;
    if (row < out_dim) {
        ps = nf_mv_row_partial(NF_WS_A, rbase, 0u, nblk);
    } else if (row < out_dim + k_rows) {
        ps = nf_mv_row_partial(NF_WS_B, (row - out_dim) * row_bytes, 0u, nblk);
    } else {
        ps = nf_mv_row_partial(NF_WS_C, (row - out_dim - k_rows) * row_bytes, 0u, nblk);
    }
    const float acc = nf_wg_sum(ps);
    if (lid == 0u) {
        if (row < out_dim) {
            y_out[row] = acc;
        } else if (row < out_dim + k_rows) {
            y_k[row - out_dim] = acc;
        } else {
            y_v[row - out_dim - k_rows] = acc;
        }
    }
#elif defined(NF_MV_GATEUP)
    float gs = 0.0;
    float us = 0.0;
    nf_mv_gateup_partial(rbase, nblk, gs, us);
    const vec2 gu = nf_wg_sum2(gs, us);
    if (lid == 0u) {
#if OP == OP_GATEUP_SILU
        y_out[row] = nf_silu(gu.x) * gu.y;
#else
        y_out[row] = nf_gelu_tanh(gu.x) * gu.y;
#endif
    }
#else
    const float acc = nf_wg_sum(nf_mv_row_partial(NF_WS_A, rbase, 0u, nblk));
    if (lid == 0u) {
#if OP == OP_MATVEC_ADD
        y_out[row] += acc;
#else
        y_out[row] = acc;
#endif
    }
#endif
#endif
}
