/* step_inputs.comp - LLM_DecodeStepInputs, the per-step inputs of a one-token decode step written on the device: the
 * GLSL twin of kernels/llm/step_inputs.cl (its arguments, effect and dispatch are documented there).
 * Requires: common/nf_common.glsl.
 *
 * Arguments (buffers take bindings 0.. in order, scalars fill the push block in order):
 *   (i row, i pos, i rope0, i rope1, i rope2, i rope3, W<int> cell_idx, W<int> kv_pos, W<int> q_pos, W<int> rope_pos)
 *   cell_idx[0] = row, kv_pos[row] = pos, q_pos[0] = pos, rope_pos[0..3] = (rope0, rope1, rope2, rope3)
 * Dispatch: global = {1}, local = {1}. One invocation; no barriers.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"

layout(std430, binding = 0) writeonly buffer NfSiCellIdx { int cell_idx[]; };
layout(std430, binding = 1) writeonly buffer NfSiKvPos { int kv_pos[]; };
layout(std430, binding = 2) writeonly buffer NfSiQPos { int q_pos[]; };
layout(std430, binding = 3) writeonly buffer NfSiRopePos { int rope_pos[]; };

layout(push_constant) uniform NfSiParams { int row; int pos; int rope0; int rope1; int rope2; int rope3; } pc;

void main() {
    if (nf_global_id() != 0u) {
        return;
    }
    cell_idx[0] = pc.row;
    kv_pos[pc.row] = pc.pos;
    q_pos[0] = pc.pos;
    rope_pos[0] = pc.rope0;
    rope_pos[1] = pc.rope1;
    rope_pos[2] = pc.rope2;
    rope_pos[3] = pc.rope3;
}
