/* flash_decode.comp - LLM_FlashDecode_<KV> and LLM_FlashDecode_Mixed split-K decode attention (GLSL twin of
 * kernels/llm/flash_decode.cl; layouts, grid, plan constraints and algorithm are documented there), plus the
 * LLM_FlashDecodePaged_* entry points under PAGED=1.
 * Requires: common/nf_common.glsl, common/act.glsl, common/kv_types.glsl, common/attn_common.glsl, common/reduce.glsl.
 *
 * Variants rows select the KV element type: KV=NF_KV_<type> (common/kv_types.glsl), or KV_MIXED=1 for
 * LLM_FlashDecode_Mixed, which reads K and V through the common/kv_types.glsl loaders with the types of its trailing
 * kv_types scalar (K type in bits 0-7, V type in bits 8-15; kernels/llm/common/attn_common.h); flag sg. Rows with the
 * additional define PAGED=1 are the LLM_FlashDecodePaged_* entry points: one launch over the batch's decode
 * sequences, whose rows live behind one page table per sequence (page_shift >= 0; kernels/llm/common/attn_common.h
 * nf_kv_row; the base rows pass page_shift = -1, the identity map), read at page_table[s * max_pages + slot's page].
 * Arguments (buffers take bindings 0.. in order, scalars fill the push block in order):
 *   (i n_head, i n_head_kv, i d_k, i d_v, i g_tile, i n_split, i split_len, i kv_start, i kv_end, i q_pos,
 *    i k_row_stride, i k_head_stride, i v_row_stride, i v_head_stride, f scale, f softcap, f max_bias,
 *    i flags, i swa_type, i n_swa, i bias_mode, i n_buckets, i max_distance,
 *    i q_off, i out_off,
 *    R q, R k, R v, R<int> kv_pos, R sinks, R rel_bias, W out, W partial, R kv_scales, R<uvec2> tree_mask
 *    [, i kv_types (KV_MIXED)]
 *    | PAGED: i page_shift, i max_pages, i n_seq, i q_seq_stride, i out_seq_stride,
 *      R<int> page_table, R<int> seq_kv_len, R<int> q_pos_seq, R kv_scales, R<uvec2> tree_mask)
 * tree_mask holds one uvec2 per query row (low 32 bits, high 32), the row's ancestor-or-self bitmask over the
 * step's fresh slots; under flags bit 4 (NF_ATTN_FLAG_TREE) the last n_fresh slots of the key range take their
 * visibility from it (common/attn_common.glsl nf_attn_tree_visible), and every other slot keeps the position
 * rules; n_fresh rides in flags bits 5-31 (nf_attn_flag_fresh) and is 0 without the flag. The base rows launch
 * one query row per workgroup, so tree_mask[0] names it; the paged rows read the sequence's block tree_mask + s.
 * kv_scales holds the FP8 KV-cache scales as n_head_kv K values then n_head_kv V values (all 1.0 without an FP8
 * cache): pass 1 multiplies the loaded K by kv_scales[kvh] and pass 2 the loaded V by kv_scales[n_head_kv + kvh]
 * (the .cl twin nf_fd_run). A per-token-head cache stores its per-(row, KV head) scales interleaved in the same
 * buffer ([row0 K heads, row0 V heads, ...]).
 * flags packs causal (bit 0), has_sinks (bit 1), direct_out (bit 2), the tree mask (bit 4) and n_fresh
 * (bits 5-31) (common/attn_common.glsl NF_ATTN_FLAG_*, nf_attn_flag_fresh).
 * The paged entry points ignore kv_start, kv_end and q_pos (the host passes 0).
 * Dispatch: 2-D, global {n_split * 128, n_head_kv * ceil(G / g_tile)}, local {128, 1, 1}; under PAGED the
 * sequence is folded into dimension 1 in front of the KV head and the tiles:
 * gid1 = s * n_head_kv * ceil(G / g_tile) + kvh * ceil(G / g_tile) + gt, as
 * gguf.ops.attn.FlashAttnTiling.decodePagedGlobal computes it.
 * The __sg variant needs full subgroups; 128 is a multiple of every subgroup size.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"
#include "common/act.glsl"
#include "common/kv_types.glsl"
#include "common/attn_common.glsl"

#if defined(KV) == defined(KV_MIXED)
#error "flash_decode.comp requires exactly one of KV and KV_MIXED"
#endif

/* A vendor variant (KV >= NF_KV_NVFP4) and the mixed one decode through the packed side planes and the centroid
 * table, so their cache views are byte views and the side data rides the kv_scales binding. */
#if defined(KV_MIXED)
#define NF_FD_VENDOR 1
#elif KV >= NF_KV_NVFP4
#define NF_FD_VENDOR 1
#else
#define NF_FD_VENDOR 0
#endif

layout(std430, binding = 0) readonly buffer NfFdQ { float q_in[]; };
#if NF_FD_VENDOR
NF_BUFFER_VIEWS(1, kc)
NF_KV_LOADERS(kc)
NF_BUFFER_VIEWS(2, vc)
NF_KV_LOADERS(vc)
#else
NF_ATTN_KV_VIEWS(1, kc)
NF_ATTN_KV_VIEWS(2, vc)
#endif
layout(std430, binding = 3) readonly buffer NfFdKvPos { int kv_pos[]; };
layout(std430, binding = 4) readonly buffer NfFdSinks { float sinks[]; };
layout(std430, binding = 5) readonly buffer NfFdRelBias { float rel_bias[]; };
layout(std430, binding = 6) writeonly buffer NfFdOut { float dst[]; };
layout(std430, binding = 7) writeonly buffer NfFdPartial { float partial[]; };
#if defined(PAGED)
layout(std430, binding = 8) readonly buffer NfFdPages { int page_table[]; };
layout(std430, binding = 9) readonly buffer NfFdSeqKvLen { int seq_kv_len[]; };
layout(std430, binding = 10) readonly buffer NfFdQPosSeq { int q_pos_seq[]; };
layout(std430, binding = 11) readonly buffer NfFdKvScales { float kv_scales[]; };
layout(std430, binding = 12) readonly buffer NfFdTreeMask { uvec2 tree_mask[]; };
#if NF_FD_VENDOR
layout(std430, binding = 11) readonly buffer NfFdKvScales8 { uint8_t kvs_u8[]; };
#endif
#else
layout(std430, binding = 8) readonly buffer NfFdKvScales { float kv_scales[]; };
layout(std430, binding = 9) readonly buffer NfFdTreeMask { uvec2 tree_mask[]; };
#if NF_FD_VENDOR
layout(std430, binding = 8) readonly buffer NfFdKvScales8 { uint8_t kvs_u8[]; };
#endif
#endif

#if defined(KV_MIXED)
#define NF_FD_K_TYPE nf_attn_kv_type_k(pc.kv_types)
#define NF_FD_V_TYPE nf_attn_kv_type_v(pc.kv_types)
#else
#define NF_FD_K_TYPE KV
#define NF_FD_V_TYPE KV
#endif


layout(push_constant) uniform NfFdParams {
    int n_head; int n_head_kv; int d_k; int d_v; int g_tile;
    int n_split; int split_len; int kv_start; int kv_end; int q_pos;
    int k_row_stride; int k_head_stride; int v_row_stride; int v_head_stride;
    float scale; float softcap; float max_bias;
    int flags; int swa_type; int n_swa;
    int bias_mode; int n_buckets; int max_distance;
    int q_off; int out_off;
#if defined(PAGED)
    int page_shift; int max_pages; int n_seq; int q_seq_stride; int out_seq_stride;
#endif
#if defined(KV_MIXED)
    int kv_types;
#endif
} pc;

#if NF_FD_VENDOR
NF_KV_VENDOR_DECODE(kc, kc, kvs, kv_scales)
NF_KV_VENDOR_DECODE(vc, vc, kvs, kv_scales)

/* V of a latent cache reads the K row (flags bit NF_ATTN_FLAG_V_ALIAS) and therefore the K side planes. */
bool nf_fd_v_alias() { return (pc.flags & NF_ATTN_FLAG_V_ALIAS) != 0; }

/* Bytes of one row of the K / V packed side planes of a vendor cache side, 0 for a side without planes. */
uint nf_fd_k_plane() {
    return nf_kv_is_vendor(NF_FD_K_TYPE)
        ? nf_kv_vendor_plane_bytes(NF_FD_K_TYPE, uint(pc.k_row_stride), uint(pc.n_head_kv)) : 0u;
}
uint nf_fd_v_plane() {
    return !nf_fd_v_alias() && nf_kv_is_vendor(NF_FD_V_TYPE)
        ? nf_kv_vendor_plane_bytes(NF_FD_V_TYPE, uint(pc.v_row_stride), uint(pc.n_head_kv)) : 0u;
}

/* Byte offset of the first plane row of the side in the kv_scales binding, and the bytes between two rows. */
uint nf_fd_plane_base(bool v) {
    return nf_kv_side_plane_base(uint(pc.n_head_kv)) + (v && !nf_fd_v_alias() ? nf_fd_k_plane() : 0u);
}
uint nf_fd_plane_stride() { return nf_fd_k_plane() + nf_fd_v_plane(); }

/* Four values e .. e + 3 of the K cache row `row`, decoded through the row's side planes when it is a vendor row. */
vec4 nf_fd_k4(uint e, int row) {
    return nf_kv_is_vendor(NF_FD_K_TYPE)
        ? kc_vendor_load4(e, row, NF_FD_K_TYPE, uint(pc.k_row_stride), uint(pc.k_head_stride),
                          nf_fd_plane_base(false), nf_fd_plane_stride())
        : kc_kv_load4(e, NF_FD_K_TYPE);
}

/* Value e of the V cache row `row`. */
float nf_fd_v1(uint e, int row) {
    return nf_kv_is_vendor(NF_FD_V_TYPE)
        ? vc_vendor_load1(e, row, NF_FD_V_TYPE, uint(pc.v_row_stride), uint(pc.v_head_stride),
                          nf_fd_plane_base(true), nf_fd_plane_stride())
        : vc_kv_load1(e, NF_FD_V_TYPE);
}

/* Values e .. e + 3 of a plain V cache row (the fast path's coalesced read; never a vendor row). */
vec4 nf_fd_v4(uint e, int row) {
    return vc_kv_load4(e, NF_FD_V_TYPE);
}

/* norm / |centroids| of a TurboQuant key row, else 1. */
float nf_fd_tq_score(uint e_head, int row) {
    return nf_kv_is_vendor(NF_FD_K_TYPE)
        ? kc_vendor_tq_score(e_head, row, NF_FD_K_TYPE, uint(pc.k_row_stride), uint(pc.k_head_stride),
                             nf_fd_plane_base(false), nf_fd_plane_stride())
        : 1.0;
}
#else
vec4 nf_fd_k4(uint e, int row) { return kc_load4(e); }
float nf_fd_v1(uint e, int row) { return vc_load1(e); }
vec4 nf_fd_v4(uint e, int row) { return vc_load4(e); }
float nf_fd_tq_score(uint e_head, int row) { return 1.0; }
#endif

#if defined(KV_MIXED)
/* K and V reads at the types packed in pc.kv_types (common/attn_common.glsl). */
bool nf_fd_types_ok() {
    return nf_attn_kv_type_ok(nf_attn_kv_type_k(pc.kv_types)) && nf_attn_kv_type_ok(nf_attn_kv_type_v(pc.kv_types));
}

vec4 kc_load4(uint e) { return kc_kv_load4(e, nf_attn_kv_type_k(pc.kv_types)); }
float vc_load1(uint e) { return vc_kv_load1(e, nf_attn_kv_type_v(pc.kv_types)); }
#else
bool nf_fd_types_ok() {
    return true;
}
#endif

#include "common/reduce.glsl"

shared float nf_fa_smem[NF_FA_SMEM_FLOATS];
shared float nf_fd_stats[3 * NF_FD_MAX_G];   /* m[16] | l[16] | ALiBi slope[16] */

/*
 * The warp fast path's gate (flash_decode.cl nf_fd_fast_ok), in the __sg module on 32-wide subgroups only, where a
 * subgroup is the .cl warp: one query head's K row is read as one coalesced vec4 per lane (the row spans exactly
 * one subgroup instruction) and its dot is reduced over the subgroup, so pass 1 needs no shared-memory tree per key;
 * pass 2 accumulates V the same coalesced way. Plain cache element types only (F32/F16/BF16), no row-relative bias
 * table, head dims of at most NF_FA_FAST_DIM, the split no longer than the workgroup and at most NF_FA_LG heads per
 * workgroup. Every other shape, and the plain module, runs the portable scalar body.
 */
/* Keys a subgroup of the fast path's pass 1 scores per round: their K rows are loaded before the first is reduced,
 * so NF_FD_KEYS row reads are in flight per subgroup instead of one dependent read per key. */
#define NF_FD_KEYS 4

bool nf_fd_plain_type(int t) {
    return t == NF_KV_F32 || t == NF_KV_F16 || t == NF_KV_BF16;
}

bool nf_fd_fast_ok() {
#ifdef USE_SUBGROUPS
    return gl_SubgroupSize == 32u && gl_NumSubgroups == uint(NF_FA_LG)
        && pc.d_k <= NF_FA_FAST_DIM && pc.d_v <= NF_FA_FAST_DIM
        && pc.split_len <= NF_FA_WG && pc.n_buckets == 0 && pc.g_tile <= NF_FA_LG
        && nf_fd_plain_type(NF_FD_K_TYPE) && nf_fd_plain_type(NF_FD_V_TYPE);
#else
    return false;
#endif
}

/* Plan constraints of flash_decode.cl nf_fd_plan_ok: the q, score and pass-2 lane-group tiles plus the fast path's
 * row staging (2 * split_len ints when it runs) fit the shared budget. */
bool nf_fd_plan_ok() {
    const int stage_floats = nf_fd_fast_ok() ? 2 * pc.split_len : 0;
    return nf_fd_types_ok()
        && pc.n_head > 0 && pc.n_head_kv > 0 && pc.n_head % pc.n_head_kv == 0
        && pc.g_tile >= 1 && pc.g_tile <= NF_FD_MAX_G
        && pc.d_k > 0 && pc.d_v > 0 && (pc.d_k & 3) == 0 && (pc.d_v & 3) == 0
        && pc.n_split >= 1 && pc.split_len > 0
        && pc.g_tile * (pc.d_k + pc.split_len) + NF_FA_LG * pc.g_tile * pc.d_v + stage_floats <= NF_FA_SMEM_FLOATS
        && pc.g_tile * pc.d_v <= (NF_FA_WG / NF_FA_LG) * NF_FA_ACC_MAX
        && ((pc.flags & NF_ATTN_FLAG_DIRECT) == 0 || pc.n_split == 1)
        && gl_WorkGroupSize.x == uint(NF_FA_WG);
}

#if defined(PAGED)
/* The paged plan adds the page geometry (the .cl twin nf_fd_paged_ok): page_shift is the log2 page size, bounded so
 * the physical row stays an int; the strides must be positive; seq_kv_len[s], q_pos_seq[s] and the page table are
 * validated on the host before the upload. */
bool nf_fd_paged_plan_ok() {
    return nf_fd_plan_ok()
        && pc.page_shift >= 0 && pc.page_shift <= 20 && pc.max_pages >= 1 && pc.n_seq >= 1
        && pc.q_seq_stride >= 0 && pc.out_seq_stride >= 0;
}
#endif

/* Position bias of head h (nf_attn_bias of kernels/llm/common/attn_common.h); slope = ALiBi slope of h,
 * q_row = the query token's row in the step (the sequence index on a paged decode). */
float nf_fd_bias(int h, int p_q, int p_k, float slope, int q_row) {
    if (pc.bias_mode == NF_ATTN_BIAS_ALIBI) {
        return slope * (-float(abs(p_q - p_k)));
    }
    if (pc.bias_mode == NF_ATTN_BIAS_ALIBI_SQRT) {
        return p_k <= p_q ? slope * (-sqrt(float(p_q - p_k))) : 0.0;
    }
    if (pc.bias_mode == NF_ATTN_BIAS_T5_CAUSAL || pc.bias_mode == NF_ATTN_BIAS_T5_BIDIR) {
        const int bucket = nf_t5_bucket(p_k, p_q, pc.n_buckets, pc.max_distance,
                                        pc.bias_mode == NF_ATTN_BIAS_T5_BIDIR ? 1 : 0);
        return rel_bias[bucket * pc.n_head + h];
    }
    if (pc.bias_mode == NF_ATTN_BIAS_INKLING) {
        const int dist = p_q - p_k;
        if (dist < 0 || dist >= pc.n_buckets) {
            return 0.0;
        }
        return rel_bias[(q_row * pc.n_head + h) * pc.n_buckets + dist];
    }
    return 0.0;
}

/* NaN over the outputs of a call that violates the plan (workgroup (0, 0) only; the paged twin covers all n_seq
 * sequence blocks, whose direct-out stride is n_head * d_v). */
void nf_fd_poison() {
    if (gl_WorkGroupID.x != 0u || gl_WorkGroupID.y != 0u || pc.n_head <= 0 || pc.d_v <= 0 || pc.n_split <= 0) {
        return;
    }
    const uint lid = gl_LocalInvocationID.x;
    if ((pc.flags & NF_ATTN_FLAG_DIRECT) != 0) {
        const uint n = uint(pc.n_head * pc.d_v);
        for (uint i = lid; i < n; i += gl_WorkGroupSize.x) {
            dst[uint(pc.out_off) + i] = NF_NAN;
        }
    } else {
        const uint n = uint(pc.n_head * pc.n_split * (pc.d_v + 2));
        for (uint i = lid; i < n; i += gl_WorkGroupSize.x) {
            partial[i] = NF_NAN;
        }
    }
}

#if defined(PAGED)
void nf_fd_paged_poison() {
    if (gl_WorkGroupID.x != 0u || gl_WorkGroupID.y != 0u
        || pc.n_seq <= 0 || pc.n_head <= 0 || pc.d_v <= 0 || pc.n_split <= 0) {
        return;
    }
    const uint lid = gl_LocalInvocationID.x;
    if ((pc.flags & NF_ATTN_FLAG_DIRECT) != 0) {
        const uint n = uint(pc.n_head * pc.d_v);
        for (int s = 0; s < pc.n_seq; s++) {
            for (uint i = lid; i < n; i += gl_WorkGroupSize.x) {
                dst[uint(pc.out_off) + uint(s) * n + i] = NF_NAN;
            }
        }
    } else {
        const uint n = uint(pc.n_seq * pc.n_head * pc.n_split * (pc.d_v + 2));
        for (uint i = lid; i < n; i += gl_WorkGroupSize.x) {
            partial[i] = NF_NAN;
        }
    }
}
#endif

/*
 * Physical row of a key slot for the sequence s (nf_kv_row of kernels/llm/common/attn_common.h): the sequence's
 * page table starts at s * maxPages (the host-validated int[nSeq x maxPages], PagedStep.pageTable(g)), and a
 * negative page id masks the slot (the base rows' identity map: every slot t is row t, no page is masked).
 */
#if defined(PAGED)
int nf_fd_page_id(int s, int slot) {
    return page_table[uint(s * pc.max_pages + (slot >> pc.page_shift))];
}

int nf_fd_row(int s, int slot) {
    return nf_kv_row(slot, pc.page_shift, nf_fd_page_id(s, slot));
}

bool nf_fd_page_ok(int s, int slot) {
    return nf_fd_page_id(s, slot) >= 0;
}
#else
int nf_fd_row(int s, int slot) {
    return slot;
}

bool nf_fd_page_ok(int s, int slot) {
    return true;
}
#endif

void main() {
#if defined(PAGED)
    if (!nf_fd_paged_plan_ok()) {
        nf_fd_paged_poison();
        return;   /* uniform across the workgroup: no barrier has been reached */
    }
#else
    if (!nf_fd_plan_ok()) {
        nf_fd_poison();
        return;   /* uniform across the workgroup: no barrier has been reached */
    }
#endif

    const int lid = int(gl_LocalInvocationID.x);
    const int split = int(gl_WorkGroupID.x);
    const int g_tile = pc.g_tile;
    const int d_k = pc.d_k;
    const int d_v = pc.d_v;
    const int split_len = pc.split_len;
    const int G = pc.n_head / pc.n_head_kv;
    const int n_gt = (G + g_tile - 1) / g_tile;
#if defined(PAGED)
    const int seq = int(gl_WorkGroupID.y) / (pc.n_head_kv * n_gt);
    const int gid = int(gl_WorkGroupID.y) - seq * (pc.n_head_kv * n_gt);
#else
    const int seq = -1;
    const int gid = int(gl_WorkGroupID.y);
#endif
    const int kvh = gid / n_gt;
    const int gt = gid - kvh * n_gt;
    const int h0 = kvh * G + gt * g_tile;
    const int g_cnt = min(g_tile, G - gt * g_tile);
#if defined(PAGED)
    /* the sequence's slots [0, kv_len), with kv_len = seq_kv_len[seq] clamped to the page table's slots
     * (the host contract is that seqKvLen <= maxPages << page_shift; the clamp keeps every
     * page-table read in bounds), and the per-sequence q / out blocks */
    const int kv_cap_len = pc.max_pages << pc.page_shift;
    const int kv_len = seq_kv_len[seq] < 0 ? 0
                       : (seq_kv_len[seq] > kv_cap_len ? kv_cap_len : seq_kv_len[seq]);
    const int kv_end = kv_len;
    const int kv_start = 0;
    const int q_pos = q_pos_seq[seq];
    const int q_off = pc.q_off + seq * pc.q_seq_stride;
    const int out_off = pc.out_off + seq * pc.out_seq_stride;
#else
    const int kv_end = pc.kv_end;
    const int kv_start = pc.kv_start;
    const int q_pos = pc.q_pos;
    const int q_off = pc.q_off;
    const int out_off = pc.out_off;
#endif
    const int k_begin = kv_start + split * split_len;
    const int k_stop = split < pc.n_split ? min(k_begin + split_len, kv_end) : k_begin;
    const int n_keys = max(0, k_stop - k_begin);
    const int s_base = g_tile * d_k;   /* s_s = nf_fa_smem[s_base ..] */
    /* The step's one query row (the sequence's row on a paged decode) and its tree-mask word. */
    const uvec2 t_bits = tree_mask[
#if defined(PAGED)
        seq
#else
        0
#endif
    ];

    /* 1. stage q and the per-head ALiBi slopes */
    for (int i = lid; i < g_tile * d_k; i += NF_FA_WG) {
        const int g = i / d_k;
        nf_fa_smem[i] = g < g_cnt ? q_in[uint(q_off + (h0 + g) * d_k + (i - g * d_k))] : 0.0;
    }
    if (lid < g_tile) {
        nf_fd_stats[2 * NF_FD_MAX_G + lid] = ((pc.bias_mode == NF_ATTN_BIAS_ALIBI || pc.bias_mode == NF_ATTN_BIAS_ALIBI_SQRT) && lid < g_cnt)
                                             ? nf_alibi_slope(h0 + lid, pc.n_head, pc.max_bias) : 1.0;
    }
    barrier();

    /* 1b. stage the fast path's rows: the split's physical rows and their kv_pos, resolved by the whole workgroup
     * at once (each invocation one key's page id -> row -> position chain) instead of once per serial scan step of
     * a subgroup below. A masked page stages row -1, which every reader treats as the absent key the page test
     * gates; the rows ride the shared budget after the pass-2 partials, as int bits. */
    const bool fast = nf_fd_fast_ok();
    const int rows_base = s_base + g_tile * split_len + NF_FA_LG * g_tile * d_v;
    const int pos_base = rows_base + split_len;
    if (fast) {
        for (int j = lid; j < n_keys; j += NF_FA_WG) {
            int row = -1;
            int p = -1;
            if (nf_fd_page_ok(seq, k_begin + j)) {
                row = nf_fd_row(seq, k_begin + j);
                p = kv_pos[row];
            }
            nf_fa_smem[rows_base + j] = intBitsToFloat(row);
            nf_fa_smem[pos_base + j] = intBitsToFloat(p);
        }
        barrier();
    }

    /* 2. pass 1: scores of the split's keys, per-invocation running max. On the fast path subgroup w scans the
     * keys w, w + NF_FA_LG, ... of the split, NF_FD_KEYS per round, every lane holding one vec4 of a key's K row and
     * the per-head dot reduced over the subgroup, so every subgroup has keys even when the split is one subgroup
     * wide; the scalar body is the portable form (plain modules, other caches, longer splits). */
    float mx[NF_FD_MAX_G];
    [[unroll]] for (int g = 0; g < NF_FD_MAX_G; g++) {
        mx[g] = -NF_INF;
    }
    const uint k_head = uint(kvh * pc.k_head_stride);
#ifdef USE_SUBGROUPS
    if (fast) {
        const int slane = int(gl_SubgroupInvocationID);
        const int dk4 = d_k >> 2;
        for (int jb = int(gl_SubgroupID); jb < split_len; jb += NF_FD_KEYS * NF_FA_LG) {
            /* NF_FD_KEYS keys per round, their K rows loaded before any is reduced */
            int p_k[NF_FD_KEYS];
            int vis[NF_FD_KEYS];
            vec4 k4[NF_FD_KEYS];
            [[unroll]] for (int u = 0; u < NF_FD_KEYS; u++) {
                const int j = jb + u * NF_FA_LG;
                p_k[u] = -1;
                vis[u] = 0;
                k4[u] = vec4(0.0);
                if (j < n_keys && floatBitsToInt(nf_fa_smem[rows_base + j]) >= 0) {
                    const int row = floatBitsToInt(nf_fa_smem[rows_base + j]);
                    p_k[u] = floatBitsToInt(nf_fa_smem[pos_base + j]);
                    vis[u] = nf_attn_tree_visible(p_k[u], t_bits, kv_end, nf_attn_flag_fresh(pc.flags), q_pos,
                                                  (pc.flags & NF_ATTN_FLAG_CAUSAL), pc.swa_type, pc.n_swa) != 0 ? 1 : 0;
                    if (vis[u] != 0 && slane < dk4) {
                        const uint e0 = uint(row) * uint(pc.k_row_stride) + k_head;
                        k4[u] = nf_fd_k4(e0 + uint(slane * 4), row) * kv_scales[kvh];
                    }
                }
            }
            [[unroll]] for (int u = 0; u < NF_FD_KEYS; u++) {
                const int j = jb + u * NF_FA_LG;
                [[unroll]] for (int g = 0; g < 4; g++) {
                    if (g < g_tile) {
                        float part = 0.0;
                        if (vis[u] != 0 && slane < dk4) {
                            const int qi = g * d_k + slane * 4;
                            part = dot(vec4(nf_fa_smem[qi], nf_fa_smem[qi + 1], nf_fa_smem[qi + 2],
                                            nf_fa_smem[qi + 3]), k4[u]);
                        }
                        const float dot_qk = subgroupAdd(part);
                        float sc = -NF_INF;
                        if (vis[u] != 0 && g < g_cnt) {
                            sc = nf_attn_score(dot_qk, pc.scale, pc.softcap)
                               + nf_fd_bias(h0 + g, q_pos, p_k[u], nf_fd_stats[2 * NF_FD_MAX_G + g], max(seq, 0));
                        }
                        if (slane == 0 && j < split_len) {
                            nf_fa_smem[s_base + g * split_len + j] = sc;
                        }
                        mx[g] = max(mx[g], sc);
                    }
                }
            }
        }
    } else
#endif
    {
        for (int j = lid; j < split_len; j += NF_FA_WG) {
            float acc[NF_FD_MAX_G];
            [[unroll]] for (int g = 0; g < NF_FD_MAX_G; g++) {
                acc[g] = 0.0;
            }
            int p_k = -1;
            int vis = 0;
            if (j < n_keys && nf_fd_page_ok(seq, k_begin + j)) {
                const int t = k_begin + j;
                /* A masked page's row is not a row, so kv_pos is read only after the page test; an empty cell's
                 * kv_pos stays -1 and is never visible. */
                const int row = nf_fd_row(seq, t);
                p_k = kv_pos[row];
                vis = nf_attn_tree_visible(p_k, t_bits, kv_end, nf_attn_flag_fresh(pc.flags), q_pos,
                                           (pc.flags & NF_ATTN_FLAG_CAUSAL), pc.swa_type, pc.n_swa) != 0 ? 1 : 0;
                if (vis != 0) {
                    const uint e0 = uint(row) * uint(pc.k_row_stride) + k_head;
                    float ks = nf_kv_is_per_token_head(NF_FD_K_TYPE)
                        ? kv_scales[(row * 2u) * uint(pc.n_head_kv) + kvh] : kv_scales[kvh];
                    ks *= nf_fd_tq_score(e0, row);
                    for (int d = 0; d < d_k; d += 4) {
                        const vec4 k4 = nf_fd_k4(e0 + uint(d), row) * ks;
                        [[unroll]] for (int g = 0; g < NF_FD_MAX_G; g++) {
                            if (g < g_tile) {
                                const int qi = g * d_k + d;
                                acc[g] += dot(vec4(nf_fa_smem[qi], nf_fa_smem[qi + 1], nf_fa_smem[qi + 2],
                                                   nf_fa_smem[qi + 3]), k4);
                            }
                        }
                    }
                }
            }
            [[unroll]] for (int g = 0; g < NF_FD_MAX_G; g++) {
                if (g < g_tile) {
                    float s = -NF_INF;
                    if (vis != 0 && g < g_cnt) {
                        s = nf_attn_score(acc[g], pc.scale, pc.softcap)
                          + nf_fd_bias(h0 + g, q_pos, p_k, nf_fd_stats[2 * NF_FD_MAX_G + g], max(seq, 0));
                    }
                    nf_fa_smem[s_base + g * split_len + j] = s;
                    mx[g] = max(mx[g], s);
                }
            }
        }
    }

    /* 3. per-head max, p = e^(s - m) in place, sum */
    float ls[NF_FD_MAX_G];
    [[unroll]] for (int g = 0; g < NF_FD_MAX_G; g++) {
        ls[g] = 0.0;
        if (g < g_tile) {
            mx[g] = nf_wg_max(mx[g]);
        }
    }
    for (int j = lid; j < split_len; j += NF_FA_WG) {
        [[unroll]] for (int g = 0; g < NF_FD_MAX_G; g++) {
            if (g < g_tile) {
                const int si = s_base + g * split_len + j;
                const float p = nf_attn_rescale(nf_fa_smem[si], mx[g]);
                nf_fa_smem[si] = p;
                ls[g] += p;
            }
        }
    }
    [[unroll]] for (int g = 0; g < NF_FD_MAX_G; g++) {
        if (g < g_tile) {
            const float l = nf_wg_sum(ls[g]);
            if (lid == 0) {
                nf_fd_stats[g] = mx[g];
                nf_fd_stats[NF_FD_MAX_G + g] = l;
            }
        }
    }
    barrier();

    /* 4. pass 2: o[g][d] = sum_t p[g][t] * V[t][d]. The workgroup runs as n_lg lane groups of gs invocations that
     * own interleaved keys (j = lg, step n_lg), so n_lg key streams run in parallel: every lane group accumulates
     * every (g, d) pair over its own keys, lane l of a group owning pairs l, l + gs, .... The groups stage their
     * accumulators in o_s; each invocation then sums the partials of the pairs it writes in step 5 (pairs lid,
     * lid + NF_FA_WG, ...). On the fast path lane group lg is subgroup lg and each lane holds the vec4 of dims
     * lane * 4 of every o[g], so one coalesced V row read feeds the group's lane slice per key. */
    const int n_pairs = g_tile * d_v;
    const int n_lg = n_pairs <= 32 * NF_FA_ACC_MAX ? NF_FA_LG : 1;
    const int gs = NF_FA_WG / n_lg;
    const int o_base = s_base + g_tile * split_len;
    const uint v_head = uint(kvh * pc.v_head_stride);
    float o[NF_FA_ACC_MAX];
    int pg[NF_FA_ACC_MAX];
    int pd[NF_FA_ACC_MAX];
#ifdef USE_SUBGROUPS
    if (fast && n_pairs <= 32 * NF_FA_ACC_MAX) {
        const int lg = int(gl_SubgroupID);
        const int lane = int(gl_SubgroupInvocationID);
        const int dv4 = d_v >> 2;
        vec4 acc[4];
        [[unroll]] for (int g = 0; g < 4; g++) {
            acc[g] = vec4(0.0);
        }
        const float v_scale = kv_scales[uint(pc.n_head_kv) + kvh];
        for (int jb = lg; jb < n_keys; jb += NF_FD_KEYS * n_lg) {
            /* NF_FD_KEYS keys per round, their V rows loaded before the first is accumulated (in key order, so the
             * sums match the one-key loop). A key no head of the tile weights (masked, or on an unmapped page) is
             * not read: its row is not a row off the page table. The test is uniform across the lane group. */
            vec4 v4[NF_FD_KEYS];
            [[unroll]] for (int u = 0; u < NF_FD_KEYS; u++) {
                const int j = jb + u * n_lg;
                v4[u] = vec4(0.0);
                bool live = false;
                if (j < n_keys) {
                    [[unroll]] for (int g = 0; g < 4; g++) {
                        live = live || (g < g_tile && nf_fa_smem[s_base + g * split_len + j] != 0.0);
                    }
                }
                if (live && lane < dv4) {
                    const int vrow = floatBitsToInt(nf_fa_smem[rows_base + j]);
                    const uint e0 = uint(vrow) * uint(pc.v_row_stride) + v_head;
                    v4[u] = nf_fd_v4(e0 + uint(lane * 4), vrow) * v_scale;
                }
            }
            [[unroll]] for (int u = 0; u < NF_FD_KEYS; u++) {
                const int j = jb + u * n_lg;
                [[unroll]] for (int g = 0; g < 4; g++) {
                    if (g < g_tile && j < n_keys) {
                        const float p = nf_fa_smem[s_base + g * split_len + j];
                        if (p != 0.0) {
                            acc[g] += p * v4[u];
                        }
                    }
                }
            }
        }
        [[unroll]] for (int g = 0; g < 4; g++) {
            if (g < g_tile && lane < dv4) {
                const int ob = o_base + lg * n_pairs + g * d_v + lane * 4;
                nf_fa_smem[ob] = acc[g].x;
                nf_fa_smem[ob + 1] = acc[g].y;
                nf_fa_smem[ob + 2] = acc[g].z;
                nf_fa_smem[ob + 3] = acc[g].w;
            }
        }
    } else
#endif
    {
        const int lg = lid / gs;
        const int lane = lid - lg * gs;
        [[unroll]] for (int i = 0; i < NF_FA_ACC_MAX; i++) {
            const int pi = lane + i * gs;
            const int g = pi < n_pairs ? pi / d_v : 0;
            o[i] = 0.0;
            pg[i] = g;
            pd[i] = pi - g * d_v;
        }
        for (int j = lg; j < n_keys; j += n_lg) {
            const int vrow = nf_fd_row(seq, k_begin + j);
            const uint e0 = uint(vrow) * uint(pc.v_row_stride) + v_head;
            const float v_scale = nf_kv_is_per_token_head(NF_FD_V_TYPE)
                ? kv_scales[(vrow * 2u + 1u) * uint(pc.n_head_kv) + kvh]
                : kv_scales[uint(pc.n_head_kv) + kvh];
            [[unroll]] for (int i = 0; i < NF_FA_ACC_MAX; i++) {
                if (lane + i * gs < n_pairs) {
                    const float p = nf_fa_smem[s_base + pg[i] * split_len + j];
                    if (p != 0.0) {
                        o[i] += p * (nf_fd_v1(e0 + uint(pd[i]), vrow) * v_scale);
                    }
                }
            }
        }
        [[unroll]] for (int i = 0; i < NF_FA_ACC_MAX; i++) {
            const int pi = lane + i * gs;
            if (pi < n_pairs) {
                nf_fa_smem[o_base + lg * n_pairs + pi] = o[i];
            }
        }
    }
    barrier();
    [[unroll]] for (int i = 0; i < NF_FA_ACC_MAX; i++) {
        const int pi = lid + i * NF_FA_WG;
        const int g = pi < n_pairs ? pi / d_v : 0;
        float sum = 0.0;
        if (pi < n_pairs) {
            for (int w = 0; w < n_lg; w++) {
                sum += nf_fa_smem[o_base + w * n_pairs + pi];
            }
        }
        o[i] = sum;
        pg[i] = g;
        pd[i] = pi - g * d_v;
    }

    /* 5. output */
    [[unroll]] for (int i = 0; i < NF_FA_ACC_MAX; i++) {
        const int g = pg[i];
        const int d = pd[i];
        if (lid + i * NF_FA_WG < n_pairs && g < g_cnt && split < pc.n_split) {
            const int h = h0 + g;
            const float m = nf_fd_stats[g];
            const float l = nf_fd_stats[NF_FD_MAX_G + g];
            if ((pc.flags & NF_ATTN_FLAG_DIRECT) != 0) {
                const vec2 fl = (pc.flags & NF_ATTN_FLAG_SINKS) != 0 ? nf_attn_sink(m, l, sinks[h]) : vec2(1.0, l);
                dst[uint(out_off + h * d_v + d)] = fl.y > 0.0 ? o[i] * fl.x / fl.y : 0.0;
            } else {
#if defined(PAGED)
                const uint pb = uint(((seq * pc.n_head + h) * pc.n_split + split) * (d_v + 2));
#else
                const uint pb = uint((h * pc.n_split + split) * (d_v + 2));
#endif
                partial[pb + uint(d)] = o[i];
                if (d == 0) {
                    partial[pb + uint(d_v)] = m;
                    partial[pb + uint(d_v + 1)] = l;
                }
            }
        }
    }
}
