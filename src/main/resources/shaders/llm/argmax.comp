/* argmax.comp - row-wise argmax (one-pass and split forms) and the tree verify's device accept walk.
 * GLSL twins of LLM_Argmax, LLM_ArgmaxSplit, LLM_ArgmaxCombine and LLM_TreeAccept in
 * kernels/llm/sampling.cl.
 * Requires: common/nf_common.glsl.
 *
 * Variants rows:
 *     LLM_Argmax	argmax.comp	OP=OP_ARGMAX	sg
 *     LLM_ArgmaxSplit	argmax.comp	OP=OP_ARGMAX_SPLIT	sg
 *     LLM_ArgmaxCombine	argmax.comp	OP=OP_ARGMAX_COMBINE	sg
 *     LLM_TreeAccept	argmax.comp	OP=OP_TREE_ACCEPT
 *
 * Arguments (buffers take bindings 0.. in order, scalars fill the push block in order):
 *   OP_ARGMAX  (i size, float input, int max_idx, i n_rows)
 *              max_idx[row] = index of the first maximum of input[row * size .. row * size + size)
 *   OP_ARGMAX_SPLIT  (i size, i n_chunks, float input, int part, i n_rows)
 *              part[2 g], part[2 g + 1] = rank key and index of the winner of chunk g % n_chunks
 *              (NF_ARGMAX_UNROLL * L elements) of row g / n_chunks
 *   OP_ARGMAX_COMBINE  (i n_chunks, int part, int max_idx, i n_rows)
 *              max_idx[row] = index of the winner among row `row`'s n_chunks chunk winners
 *   OP_TREE_ACCEPT  (i n_nodes, int tree, int argmax, int out)
 *              the tree verify's acceptance walk (LLM_TreeAccept): tree holds 3 ints per node
 *              (token, parent, depth), argmax the verify rows' greedy ids, out the accepted depth,
 *              the first emission, the final draw and the accepted path's node indices.
 * Candidates are ordered as in nf_argmax_key / nf_argmax_before (kernels/llm/sampling.cl): a non-NaN
 * value beats NaN, the larger value wins, equal values (-0 and +0 among them) go to the lower index.
 * NaN is never selected; a row of only NaN yields 0, and so does size == 0. The order is total, so
 * the subgroup (__sg) and shared-memory reductions and every split give the same ids.
 *
 * Dispatch: 1-D, global = n_rows * L (OP_ARGMAX_SPLIT: n_rows * n_chunks * L), local = {L, 1, 1};
 * one workgroup per row or chunk (OP_TREE_ACCEPT: global = local = {L}, exactly one workgroup).
 * Folded group counts are recovered by nf_wg_id(); surplus groups exit uniformly. Any L is reduced
 * exactly.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"

#define OP_ARGMAX 131
#define OP_TREE_ACCEPT 132
#define OP_ARGMAX_SPLIT 133
#define OP_ARGMAX_COMBINE 134

#if !defined(OP)
#error "argmax.comp requires OP"
#endif
#if OP != OP_ARGMAX && OP != OP_TREE_ACCEPT && OP != OP_ARGMAX_SPLIT && OP != OP_ARGMAX_COMBINE
#error "argmax.comp requires OP=OP_ARGMAX, OP_ARGMAX_SPLIT, OP_ARGMAX_COMBINE or OP_TREE_ACCEPT"
#endif

#if OP == OP_ARGMAX
layout(std430, binding = 0) buffer NfAmInput { float x_in[]; };
layout(std430, binding = 1) buffer NfAmOutput { int max_idx[]; };
layout(push_constant) uniform NfAmParams { int size; int n_rows; } pc;
#elif OP == OP_ARGMAX_SPLIT
layout(std430, binding = 0) buffer NfAmInput { float x_in[]; };
layout(std430, binding = 1) buffer NfAmPart { int part[]; };
layout(push_constant) uniform NfAmParams { int size; int n_chunks; int n_rows; } pc;
#elif OP == OP_ARGMAX_COMBINE
layout(std430, binding = 0) buffer NfAmPart { int part[]; };
layout(std430, binding = 1) buffer NfAmOutput { int max_idx[]; };
layout(push_constant) uniform NfAmParams { int n_chunks; int n_rows; } pc;
#else
layout(std430, binding = 0) buffer NfAmTree { int tree[]; };
layout(std430, binding = 1) buffer NfAmRowIds { int row_ids[]; };
layout(std430, binding = 2) buffer NfAmAccept { int accept[]; };
layout(push_constant) uniform NfAmParams { int block0; } pc;
#endif

/* Index sentinel of an argmax candidate that holds no element. */
#define NF_ARGMAX_NONE 0x7fffffff
/* Elements each invocation of an OP_ARGMAX_SPLIT group loads (sampling.cl NF_ARGMAX_UNROLL). */
#define NF_ARGMAX_UNROLL 8

#if OP != OP_TREE_ACCEPT

shared uint nf_am_k[gl_WorkGroupSize.x];
shared int nf_am_i[gl_WorkGroupSize.x];

/* Rank key of a value in the argmax order (sampling.cl nf_argmax_key): NaN 0, -0 as +0, otherwise
 * the sign-magnitude bits as two's-order bits. Bits only, so the driver's NaN handling of float
 * instructions never enters the order. */
uint nf_argmax_key(float v) {
    const uint u = floatBitsToUint(v);
    const uint a = u & 0x7fffffffu;
    if (a > 0x7f800000u) {
        return 0u;
    }
    if (a == 0u) {
        return 0x80000000u;
    }
    return (u & 0x80000000u) != 0u ? ~u : (u | 0x80000000u);
}

/* True when candidate (k, i) beats (bk, bi). */
bool nf_argmax_before(uint k, int i, uint bk, int bi) {
    return k > bk || (k == bk && i < bi);
}

/* Work-group reduction of every invocation's candidate; the winner is valid in invocation 0. Every
 * invocation calls it in uniform control flow. The __sg variant folds each subgroup by subgroupMax of
 * the keys and subgroupMin of the indices holding the maximum key, then invocation 0 folds the
 * subgroup winners; the plain variant runs a shared-memory tree. */
void nf_wg_argmax(inout uint k, inout int i) {
    const uint lid = gl_LocalInvocationID.x;
#ifdef USE_SUBGROUPS
    const uint mk = subgroupMax(k);
    i = subgroupMin(k == mk ? i : NF_ARGMAX_NONE);
    k = mk;
    if (subgroupElect()) {
        nf_am_k[gl_SubgroupID] = k;
        nf_am_i[gl_SubgroupID] = i;
    }
    barrier();
    if (lid == 0u) {
        k = nf_am_k[0];
        i = nf_am_i[0];
        for (uint w = 1u; w < gl_NumSubgroups; ++w) {
            if (nf_argmax_before(nf_am_k[w], nf_am_i[w], k, i)) {
                k = nf_am_k[w];
                i = nf_am_i[w];
            }
        }
    }
#else
    const uint lsize = gl_WorkGroupSize.x;
    nf_am_k[lid] = k;
    nf_am_i[lid] = i;
    barrier();
    /* smallest power of two >= the local size; the upper half folds with a bounds check */
    const uint span = lsize <= 1u ? 1u : (1u << uint(findMSB(lsize - 1u) + 1));
    for (uint s = span >> 1; s > 0u; s >>= 1) {
        if (lid < s && lid + s < lsize
                && nf_argmax_before(nf_am_k[lid + s], nf_am_i[lid + s], nf_am_k[lid], nf_am_i[lid])) {
            nf_am_k[lid] = nf_am_k[lid + s];
            nf_am_i[lid] = nf_am_i[lid + s];
        }
        barrier();
    }
    k = nf_am_k[0];
    i = nf_am_i[0];
#endif
}

void main() {
    const uint g = nf_wg_id();
    const uint lid = gl_LocalInvocationID.x;
    const uint lsize = gl_WorkGroupSize.x;
    uint bk = 0u;
    int bi = NF_ARGMAX_NONE;
#if OP == OP_ARGMAX
    if (g >= uint(pc.n_rows)) {
        return;
    }
    const int size = pc.size;
    const uint base = g * uint(size);
    for (int i = int(lid); i < size; i += int(lsize)) {
        const uint k = nf_argmax_key(x_in[base + uint(i)]);
        if (nf_argmax_before(k, i, bk, bi)) {
            bk = k;
            bi = i;
        }
    }
#elif OP == OP_ARGMAX_SPLIT
    const uint n_chunks = uint(pc.n_chunks);
    if (g >= uint(pc.n_rows) * n_chunks) {
        return;
    }
    const int size = pc.size;
    const uint row = g / n_chunks;
    const uint base = row * uint(size);
    const int i0 = int((g - row * n_chunks) * (NF_ARGMAX_UNROLL * lsize) + lid);
    float v[NF_ARGMAX_UNROLL];
    [[unroll]] for (int u = 0; u < NF_ARGMAX_UNROLL; ++u) {
        const int i = i0 + u * int(lsize);
        v[u] = i < size ? x_in[base + uint(i)] : NF_NAN;
    }
    [[unroll]] for (int u = 0; u < NF_ARGMAX_UNROLL; ++u) {
        const int i = i0 + u * int(lsize);
        const uint k = nf_argmax_key(v[u]);
        if (i < size && nf_argmax_before(k, i, bk, bi)) {
            bk = k;
            bi = i;
        }
    }
#else
    if (g >= uint(pc.n_rows)) {
        return;
    }
    const int n_chunks = pc.n_chunks;
    const uint base = 2u * g * uint(n_chunks);
    for (int c = int(lid); c < n_chunks; c += int(lsize)) {
        const uint k = uint(part[base + 2u * uint(c)]);
        const int i = part[base + 2u * uint(c) + 1u];
        if (nf_argmax_before(k, i, bk, bi)) {
            bk = k;
            bi = i;
        }
    }
#endif
    nf_wg_argmax(bk, bi);
    if (lid == 0u) {
#if OP == OP_ARGMAX_SPLIT
        part[2u * g] = int(bk);
        part[2u * g + 1u] = bi;
#else
        max_idx[g] = (bi == NF_ARGMAX_NONE) ? 0 : bi;
#endif
    }
}

#else

/* The tree verify's acceptance walk on the device: per depth one scan of the depth's nodes, one
 * reduction of the smallest matched index and the matched bit set, one uniform advance (see
 * LLM_TreeAccept in kernels/llm/sampling.cl). */
shared int nf_am_min[gl_WorkGroupSize.x];
shared uint nf_am_lo[gl_WorkGroupSize.x];
shared uint nf_am_hi[gl_WorkGroupSize.x];
shared int nf_am_stop;

void main() {
    if (nf_wg_id() != 0u) {
        return;
    }
    const uint lid = gl_LocalInvocationID.x;
    const uint lsize = gl_WorkGroupSize.x;
    const int n_nodes = pc.block0;

    uint lo = 0u;
    uint hi = 0u;
    int pred_row = 0;
    int accepted = 0;
    const int first = row_ids[0];
    int pred = first;
    int depth = 1;

    for (;;) {
        int my_match = NF_ARGMAX_NONE;
        uint my_lo = 0u;
        uint my_hi = 0u;
        for (int i = int(lid); i < n_nodes; i += int(lsize)) {
            if (tree[3 * i + 2] != depth) {
                continue;
            }
            const int parent = tree[3 * i + 1];
            const int in_frontier = (lo | hi) == 0u
                ? int(parent == -1)
                : (parent < 32 ? int((lo >> uint(parent)) & 1u)
                               : int((hi >> uint(parent - 32)) & 1u));
            if (in_frontier == 0 || tree[3 * i] != pred) {
                continue;
            }
            if (my_match == NF_ARGMAX_NONE) {
                my_match = i; /* the scan ascends: the first hit is the smallest */
            }
            if (i < 32) {
                my_lo |= 1u << uint(i);
            } else {
                my_hi |= 1u << uint(i - 32);
            }
        }
        nf_am_min[lid] = my_match;
        nf_am_lo[lid] = my_lo;
        nf_am_hi[lid] = my_hi;
        barrier();

        /* ceiling halving: every lane's content reaches lane 0 for any work-group size (plain halving
         * drops the tail lane on a non-power-of-two lsize) */
        for (uint live = lsize; live > 1u; live = (live + 1u) >> 1u) {
            const uint stride = (live + 1u) >> 1u;
            if (lid < stride && lid + stride < live) {
                if (nf_am_min[lid + stride] < nf_am_min[lid]) {
                    nf_am_min[lid] = nf_am_min[lid + stride];
                }
                nf_am_lo[lid] |= nf_am_lo[lid + stride];
                nf_am_hi[lid] |= nf_am_hi[lid + stride];
            }
            barrier();
        }

        if (lid == 0u) {
            nf_am_stop = nf_am_min[0] == NF_ARGMAX_NONE ? 1 : 0;
        }
        barrier();
        if (nf_am_stop == 1) {
            break;
        }
        if (lid == 0u) {
            accept[3 + accepted] = nf_am_min[0];
        }
        pred_row = nf_am_min[0] + 1;
        pred = row_ids[pred_row];
        lo = nf_am_lo[0];
        hi = nf_am_hi[0];
        accepted++;
        depth++;
        /* the reads of the reduced values above must finish before the next scan writes the arrays */
        barrier();
    }

    if (lid == 0u) {
        accept[0] = accepted;
        accept[1] = first;
        accept[2] = row_ids[pred_row];
    }
}

#endif
