/* argmax.comp - row-wise argmax and the tree verify's device accept walk. GLSL twins of LLM_Argmax
 * and LLM_TreeAccept in kernels/llm/sampling.cl.
 * Requires: common/nf_common.glsl.
 *
 * Variants rows:
 *     LLM_Argmax	argmax.comp	OP=OP_ARGMAX
 *     LLM_TreeAccept	argmax.comp	OP=OP_TREE_ACCEPT
 *
 * Arguments (buffers take bindings 0.. in order, scalars fill the push block in order):
 *   OP_ARGMAX  (i size, float input, int max_idx, i n_rows)
 *              max_idx[row] = index of the first maximum of input[row * size .. row * size + size)
 *   OP_TREE_ACCEPT  (i n_nodes, int tree, int argmax, int out)
 *              the tree verify's acceptance walk (LLM_TreeAccept): tree holds 3 ints per node
 *              (token, parent, depth), argmax the verify rows' greedy ids, out the accepted depth,
 *              the first emission, the final draw and the accepted path's node indices.
 * Candidates are ordered as in nf_argmax_better (kernels/llm/sampling.cl): a non-NaN value beats NaN, the
 * larger value wins, equal values go to the lower index. NaN is never selected; a row of only NaN
 * yields 0, and so does size == 0.
 *
 * Dispatch: 1-D, global = n_rows * L, local = {L, 1, 1}; one workgroup per row (OP_TREE_ACCEPT:
 * global = local = {L}, exactly one workgroup). Folded group counts are recovered by nf_wg_id();
 * surplus groups exit uniformly. Any L is reduced exactly.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"

#define OP_ARGMAX 131
#define OP_TREE_ACCEPT 132

#if !defined(OP)
#error "argmax.comp requires OP"
#endif
#if OP != OP_ARGMAX && OP != OP_TREE_ACCEPT
#error "argmax.comp requires OP=OP_ARGMAX or OP=OP_TREE_ACCEPT"
#endif

#if OP == OP_ARGMAX
layout(std430, binding = 0) buffer NfAmInput { float x_in[]; };
layout(std430, binding = 1) buffer NfAmOutput { int max_idx[]; };
#else
layout(std430, binding = 0) buffer NfAmTree { int tree[]; };
layout(std430, binding = 1) buffer NfAmRowIds { int row_ids[]; };
layout(std430, binding = 2) buffer NfAmAccept { int accept[]; };
#endif
layout(push_constant) uniform NfAmParams { int block0; int block1; } pc;

/* Index sentinel of an argmax candidate that holds no element. */
#define NF_ARGMAX_NONE 0x7fffffff

#if OP == OP_ARGMAX

shared float nf_am_v[gl_WorkGroupSize.x];
shared int nf_am_i[gl_WorkGroupSize.x];

/* NaN test on the bit pattern, independent of the driver's float NaN handling (Vulkan treats
 * NaN operands of float instructions as undefined unless SignedZeroInfNanPreserve is enabled). */
bool nf_am_isnan(float v) {
    return (floatBitsToUint(v) & 0x7fffffffu) > 0x7f800000u;
}

/* True when candidate (v, i) beats (bv, bi). */
bool nf_argmax_better(float v, int i, float bv, int bi) {
    if (nf_am_isnan(v)) {
        return nf_am_isnan(bv) && i < bi;
    }
    if (nf_am_isnan(bv)) {
        return true;
    }
    return v > bv || (v == bv && i < bi);
}

/* Smallest power of two >= the local size; the tree folds the upper half with a bounds check. */
uint nf_am_span() {
    const uint n = gl_WorkGroupSize.x;
    return n <= 1u ? 1u : (1u << uint(findMSB(n - 1u) + 1));
}

void main() {
    const uint row = nf_wg_id();
    if (row >= uint(pc.block1)) {
        return;
    }
    const uint lid = gl_LocalInvocationID.x;
    const uint lsize = gl_WorkGroupSize.x;
    const int size = pc.block0;
    const uint base = row * uint(size);

    float bv = NF_NAN;
    int bi = NF_ARGMAX_NONE;
    for (int i = int(lid); i < size; i += int(lsize)) {
        const float v = x_in[base + uint(i)];
        if (nf_argmax_better(v, i, bv, bi)) {
            bv = v;
            bi = i;
        }
    }
    nf_am_v[lid] = bv;
    nf_am_i[lid] = bi;
    barrier();

    for (uint s = nf_am_span() >> 1; s > 0u; s >>= 1) {
        if (lid < s && lid + s < lsize) {
            const float ov = nf_am_v[lid + s];
            const int oi = nf_am_i[lid + s];
            if (nf_argmax_better(ov, oi, nf_am_v[lid], nf_am_i[lid])) {
                nf_am_v[lid] = ov;
                nf_am_i[lid] = oi;
            }
        }
        barrier();
    }

    if (lid == 0u) {
        const int r = nf_am_i[0];
        max_idx[row] = (r == NF_ARGMAX_NONE) ? 0 : r;
    }
}

#else

/* The tree verify's acceptance walk on the device: per depth one scan of the depth's nodes, one
 * reduction of the smallest matched index and the matched bit set, one uniform advance (see
 * LLM_TreeAccept in kernels/llm/sampling.cl). */
shared int nf_am_min[gl_WorkGroupSize.x];
shared uint nf_am_lo[gl_WorkGroupSize.x];
shared uint nf_am_hi[gl_WorkGroupSize.x];
shared int nf_am_stop;

void main() {
    if (nf_wg_id() != 0u) {
        return;
    }
    const uint lid = gl_LocalInvocationID.x;
    const uint lsize = gl_WorkGroupSize.x;
    const int n_nodes = pc.block0;

    uint lo = 0u;
    uint hi = 0u;
    int pred_row = 0;
    int accepted = 0;
    const int first = row_ids[0];
    int pred = first;
    int depth = 1;

    for (;;) {
        int my_match = NF_ARGMAX_NONE;
        uint my_lo = 0u;
        uint my_hi = 0u;
        for (int i = int(lid); i < n_nodes; i += int(lsize)) {
            if (tree[3 * i + 2] != depth) {
                continue;
            }
            const int parent = tree[3 * i + 1];
            const int in_frontier = (lo | hi) == 0u
                ? int(parent == -1)
                : (parent < 32 ? int((lo >> uint(parent)) & 1u)
                               : int((hi >> uint(parent - 32)) & 1u));
            if (in_frontier == 0 || tree[3 * i] != pred) {
                continue;
            }
            if (my_match == NF_ARGMAX_NONE) {
                my_match = i; /* the scan ascends: the first hit is the smallest */
            }
            if (i < 32) {
                my_lo |= 1u << uint(i);
            } else {
                my_hi |= 1u << uint(i - 32);
            }
        }
        nf_am_min[lid] = my_match;
        nf_am_lo[lid] = my_lo;
        nf_am_hi[lid] = my_hi;
        barrier();

        /* ceiling halving: every lane's content reaches lane 0 for any work-group size (plain halving
         * drops the tail lane on a non-power-of-two lsize) */
        for (uint live = lsize; live > 1u; live = (live + 1u) >> 1u) {
            const uint stride = (live + 1u) >> 1u;
            if (lid < stride && lid + stride < live) {
                if (nf_am_min[lid + stride] < nf_am_min[lid]) {
                    nf_am_min[lid] = nf_am_min[lid + stride];
                }
                nf_am_lo[lid] |= nf_am_lo[lid + stride];
                nf_am_hi[lid] |= nf_am_hi[lid + stride];
            }
            barrier();
        }

        if (lid == 0u) {
            nf_am_stop = nf_am_min[0] == NF_ARGMAX_NONE ? 1 : 0;
        }
        barrier();
        if (nf_am_stop == 1) {
            break;
        }
        if (lid == 0u) {
            accept[3 + accepted] = nf_am_min[0];
        }
        pred_row = nf_am_min[0] + 1;
        pred = row_ids[pred_row];
        lo = nf_am_lo[0];
        hi = nf_am_hi[0];
        accepted++;
        depth++;
        /* the reads of the reduced values above must finish before the next scan writes the arrays */
        barrier();
    }

    if (lid == 0u) {
        accept[0] = accepted;
        accept[1] = first;
        accept[2] = row_ids[pred_row];
    }
}

#endif
