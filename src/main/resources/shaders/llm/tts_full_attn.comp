/* tts_full_attn.comp - LLM_TtsFullAttn: bidirectional attention over every row (the lfm3a depthformer's codebook
 * pass). GLSL twin of kernels/llm/speech.cl. Requires: common/nf_common.glsl, common/tts_attend.glsl.
 *
 * Arguments: (i n_pos, i n_head, i n_head_kv, i d_head, R q, R keys, R values, W out).
 *   out[r][h][d] = softmax_j(q[r][h] . keys[j][kv(h)] / sqrt(d_head)) * values[j][kv(h)]
 * q[n_pos][n_head*d_head], keys and values [n_pos][n_head_kv*d_head], out of q's shape.
 * Dispatch: 1-D, one workgroup per (row, head) (nf_tts_attend), linear group r*n_head + h,
 * global = n_pos*n_head*L, local = {L, 1, 1}.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"

layout(std430, binding = 0) readonly buffer NfFaQ { float q_in[]; };
layout(std430, binding = 1) readonly buffer NfFaK { float keys_in[]; };
layout(std430, binding = 2) readonly buffer NfFaV { float values_in[]; };
layout(std430, binding = 3) writeonly buffer NfFaO { float out_data[]; };

layout(push_constant) uniform NfFaParams {
    int n_pos;
    int n_head;
    int n_head_kv;
    int d_head;
} pc;

#include "common/tts_attend.glsl"

void main() {
    const uint g = nf_wg_id();
    /* uniform per workgroup */
    if (g >= uint(pc.n_pos) * uint(pc.n_head)) {
        return;
    }
    const uint r = g / uint(pc.n_head);
    const uint h = g - r * uint(pc.n_head);
    const uint kv_head = h / uint(pc.n_head / pc.n_head_kv);
    const uint q_off = r * uint(pc.n_head) * uint(pc.d_head) + h * uint(pc.d_head);
    nf_tts_attend(q_off, uint(pc.n_head_kv) * uint(pc.d_head), kv_head * uint(pc.d_head), pc.d_head, 0,
                  pc.n_pos - 1, q_off);
}
