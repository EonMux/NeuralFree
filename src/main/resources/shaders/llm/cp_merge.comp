/* cp_merge.comp - LLM_AttnCpMerge context-parallel attention merge (GLSL twin of kernels/llm/cp_merge.cl;
 * the merge formula and layouts are documented there). Requires: common/nf_common.glsl, common/act.glsl,
 * common/attn_common.glsl.
 *
 * Variants row:
 *   LLM_AttnCpMerge	cp_merge.comp	(no defines, no subgroups)
 * Arguments (buffers take bindings 0.. in order, scalars fill the push block in order):
 *   (i n_rows, i d_v, i n_rank, R outs, R lses, W out)
 *   Dispatch: 1-D, global {n_rows * 128}, local {128, 1, 1}; one workgroup per row, folded group counts are
 *   recovered by nf_wg_id(). No barriers, so any local size is valid.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#include "common/nf_common.glsl"
#include "common/act.glsl"
#include "common/attn_common.glsl"

layout(std430, binding = 0) readonly buffer NfCpmOuts { float outs[]; };
layout(std430, binding = 1) readonly buffer NfCpLses { float lses[]; };
layout(std430, binding = 2) writeonly buffer NfCpmOut { float dst[]; };

layout(push_constant) uniform NfCpmParams {
    int n_rows; int d_v; int n_rank;
} pc;

void main() {
    const uint row = nf_wg_id();
    if (row >= uint(pc.n_rows) || pc.n_rank <= 0 || pc.d_v <= 0) {
        return;
    }
    const uint lid = gl_LocalInvocationID.x;
    const uint d_v = uint(pc.d_v);
    const uint n_rank = uint(pc.n_rank);
    const uint n_rows = uint(pc.n_rows);
    const uint ob = row * d_v;

    float m = -NF_INF;
    for (uint r = 0u; r < n_rank; r++) {
        m = max(m, lses[r * n_rows + row]);
    }
    if (m == -NF_INF) {
        for (uint d = lid; d < d_v; d += gl_WorkGroupSize.x) {
            dst[ob + d] = 0.0;
        }
        return;
    }
    float denom = 0.0;
    for (uint r = 0u; r < n_rank; r++) {
        denom += nf_attn_rescale(lses[r * n_rows + row], m);
    }
    for (uint d = lid; d < d_v; d += gl_WorkGroupSize.x) {
        float o = 0.0;
        for (uint r = 0u; r < n_rank; r++) {
            const float w = nf_attn_rescale(lses[r * n_rows + row], m);
            o += w * outs[(r * n_rows + row) * d_v + d];
        }
        dst[ob + d] = denom > 0.0 ? o / denom : 0.0;
    }
}
