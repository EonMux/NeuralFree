#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer BufferData {
    float data[];
};

layout(push_constant) uniform PushConstants {
    float factor;
    uint n;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid < pc.n) {
        data[gid] = data[gid] * pc.factor;
    }
}
