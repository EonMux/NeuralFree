{#- llama.cpp phi3 chat template (src/llama-chat.cpp:336-344). -#}
{%- for message in messages -%}
    {%- set content = message['content'] if message['content'] is string else '' -%}
    {{- '<|' ~ message['role'] ~ '|>\n' ~ content ~ '<|end|>\n' -}}
{%- endfor -%}
{%- if add_generation_prompt -%}
    {{- '<|assistant|>\n' -}}
{%- endif -%}
