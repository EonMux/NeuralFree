{#- llama.cpp command-r chat template (src/llama-chat.cpp:470-484). -#}
{%- for message in messages -%}
    {%- set content = (message['content'] if message['content'] is string else '') | trim(' \t\n\v\f\r') -%}
    {%- if message['role'] == 'system' -%}
        {{- '<|START_OF_TURN_TOKEN|><|SYSTEM_TOKEN|>' ~ content ~ '<|END_OF_TURN_TOKEN|>' -}}
    {%- elif message['role'] == 'user' -%}
        {{- '<|START_OF_TURN_TOKEN|><|USER_TOKEN|>' ~ content ~ '<|END_OF_TURN_TOKEN|>' -}}
    {%- elif message['role'] == 'assistant' -%}
        {{- '<|START_OF_TURN_TOKEN|><|CHATBOT_TOKEN|>' ~ content ~ '<|END_OF_TURN_TOKEN|>' -}}
    {%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}
    {{- '<|START_OF_TURN_TOKEN|><|CHATBOT_TOKEN|>' -}}
{%- endif -%}
