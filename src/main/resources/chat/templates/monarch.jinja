{#- llama.cpp monarch chat template (src/llama-chat.cpp:370-378): BOS text before every message but the first. -#}
{%- for message in messages -%}
    {%- set content = message['content'] if message['content'] is string else '' -%}
    {{- ('' if loop.first else '<s>') ~ message['role'] ~ '\n' ~ content ~ '</s>\n' -}}
{%- endfor -%}
{%- if add_generation_prompt -%}
    {{- '<s>assistant\n' -}}
{%- endif -%}
