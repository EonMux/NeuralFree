{#- llama.cpp hunyuan-dense chat template (src/llama-chat.cpp:830-845): only a first system message is kept; no generation prompt. -#}
{%- for message in messages -%}
    {%- set content = message['content'] if message['content'] is string else '' -%}
    {%- if loop.first and message['role'] == 'system' -%}
        {{- content ~ '<｜hy_place▁holder▁no▁3｜>' -}}
    {%- endif -%}
    {%- if message['role'] == 'assistant' -%}
        {{- '<｜hy_Assistant｜>' ~ content ~ '<｜hy_place▁holder▁no▁2｜>' -}}
    {%- elif message['role'] == 'user' -%}
        {{- '<｜hy_User｜>' ~ content ~ '<｜hy_Assistant｜>' -}}
    {%- endif -%}
{%- endfor -%}
