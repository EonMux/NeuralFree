{#- llama.cpp pangu-embedded chat template (src/llama-chat.cpp:903-931): an empty system turn opens a conversation without one. -#}
{%- set labels = {'system': '系统', 'user': '用户', 'assistant': '助手', 'tool': '工具', 'function': '方法'} -%}
{%- for message in messages -%}
    {%- set content = message['content'] if message['content'] is string else '' -%}
    {%- if loop.first and message['role'] != 'system' -%}
        {{- '[unused9]系统：[unused10]' -}}
    {%- endif -%}
    {%- if message['role'] in labels -%}
        {{- '[unused9]' ~ labels[message['role']] ~ '：' ~ content ~ '[unused10]' -}}
    {%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}
    {{- '[unused9]助手：' -}}
{%- endif -%}
