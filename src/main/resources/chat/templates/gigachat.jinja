{#- llama.cpp gigachat chat template (src/llama-chat.cpp:672-697): a leading system message follows the BOS text. -#}
{%- set has_system = messages | length > 0 and messages[0]['role'] == 'system' -%}
{%- if has_system -%}
    {{- '<s>' ~ (messages[0]['content'] if messages[0]['content'] is string else '') ~ '<|message_sep|>' -}}
{%- else -%}
    {{- '<s>' -}}
{%- endif -%}
{%- for message in messages -%}
    {%- set content = message['content'] if message['content'] is string else '' -%}
    {%- if not (loop.first and has_system) -%}
        {%- if message['role'] == 'user' -%}
            {{- 'user<|role_sep|>' ~ content ~ '<|message_sep|>available functions<|role_sep|>[]<|message_sep|>' -}}
        {%- elif message['role'] == 'assistant' -%}
            {{- 'assistant<|role_sep|>' ~ content ~ '<|message_sep|>' -}}
        {%- endif -%}
    {%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}
    {{- 'assistant<|role_sep|>' -}}
{%- endif -%}
