<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging configuration of the Gradle run tasks (runApp, runDemos, runLLMDemo), which pass it to the JVM as
     -Dlog4j2.configurationFile. The library jar ships no logging configuration. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
